/*
 * RNASEQ — reproducible RNA-seq pipeline (paired-end; FASTQ pairs or BAM input)
 * Reusable across projects/labmates: nothing project-specific lives here.
 * Each project supplies its own config.yaml (see examples/config.yaml,
 * fetched via `run_pipeline.sh init`) and runs with:
 *   nextflow run /project/rephilllab/RNASEQ -profile pmacs -params-file config.yaml
 *
 * Directory convention (shared across all lab pipelines, not just this one):
 *   samplesheet.csv              — your own small input CSV, lives at the project
 *                                  root (config.yaml too)
 *   metadata/                    — pipeline-generated run metadata: Nextflow's own
 *                                  execution report/trace/timeline/DAG, LSF head-job logs,
 *                                  and .nextflow.log (NOT this pipeline's own inputs —
 *                                  kept for consistency with pipelines that do populate
 *                                  it with their own generated metadata)
 *   original_data/fastq/        — per-sample FASTQ(s): supplied directly by the user
 *                                  (this pipeline has no demultiplexing step);
 *                                  samplesheet.csv may also point at FASTQs or BAMs elsewhere
 *   intermediate_files/         — large per-sample intermediates (FASTQ from BAM, trimmed FASTQ,
 *                                  aligned and filtered BAMs)
 *   results/<step>/             — final outputs, one subfolder per pipeline step
 *
 * Not relocatable into metadata/: .nextflow/ (Nextflow's own resume cache +
 * history) always lives at the directory nextflow was launched from — no
 * flag moves it independently, and moving the whole launch directory would
 * break every relative path in config.yaml. Verified empirically, not
 * assumed — see the pipeline's git history for the test.
 */

manifest {
    name            = 'RNASEQ'
    description     = 'Reproducible RNA-seq pipeline (trim -> HISAT2 -> filter -> mark duplicates -> strandedness check -> featureCounts -> merged counts -> MultiQC; optional DESeq2 differential expression, run_deg) for PMACS/LSF'
    author          = 'Rephill Lab'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=26.04.0'
    version         = '0.2.0'
}

// ---------------------------------------------------------------------------
// Default parameters — override per-project via -params-file config.yaml
// (do NOT edit these defaults for a specific project; use your own config.yaml)
// ---------------------------------------------------------------------------
params {
    // ---- Project identity ---------------------------------------------
    project_name         = 'my_rnaseq'     // prefix of the counts matrix (<project_name>_counts.txt) and other project-level outputs

    // ---- Inputs (CSVs live at the project root) -------------------------
    samplesheet          = 'samplesheet.csv'   // one row per library: sample_id, fastq_1, fastq_2 or bam, exclude, plus free metadata columns
    // Optional: a directory of FASTQs. run_pipeline.sh moves its *.fastq.gz / *.fastq
    // into original_data/fastq/ (unless it already is that directory) and rewrites
    // this value. The samplesheet's fastq_1/fastq_2 paths are used as given either way.
    fastq_dir            = null

    // ---- Output / directory convention -------------------------------
    // See the directory-convention comment at the top of this file.
    outdir               = './results'
    metadata_dir         = './metadata'
    intermediate_dir     = './intermediate_files'
    publish_mode         = 'copy'   // 'copy' (safe default) or 'symlink' (saves space, same filesystem only)
    lsf_exclude_hosts    = ''       // pmacs profile: comma list of LSF hosts never used (e.g. 'nodeNNN' while that node is broken)
    // Launch timestamp (yyyyMMdd_HHmmss): names the trace, report, timeline and DAG files, so a resumed run
    // does not overwrite the previous run's files.
    run_timestamp        = new Date().format('yyyyMMdd_HHmmss')

    lsf_watchdog         = true   // head job runs lib/lsf_watchdog.sh; false = off (read by run_pipeline.sh)

    // ---- References ---------------------------------------------------
    hisat2_index         = null   // HISAT2 index PREFIX of the genome, e.g. /path/t2t/chm13-2 (files <prefix>.N.ht2 or <prefix>.N.ht2l; required)
    gtf                  = null   // gene annotation GTF (required; featureCounts and the strandedness gene model)

    // ---- Strandedness ---------------------------------------------------
    strandedness         = 'unstranded'   // unstranded | forward | reverse: the library type given to featureCounts (-s 0 | 1 | 2)
                                          // (legacy GG = unstranded). The automatic check (RSeQC) warns on a mismatch; it never changes the counting.

    // ---- Step switches -------------------------------------------------
    run_fastqc           = true   // FastQC on raw and trimmed reads (both reads of each pair)
    trim                 = true   // run Trimmomatic before alignment (false = reads pass through unchanged)
    mark_duplicates      = true   // Picard MarkDuplicates (false = the filtered BAM is the final BAM)
    remove_duplicates    = false  // true = REMOVE_DUPLICATES (requires mark_duplicates); featureCounts counts all reads either way
    run_multiqc          = true   // MultiQC report
    help                 = false

    // ---- Trimming (Trimmomatic) ---------------------------------------
    trim_adapter_set     = 'TruSeq3-PE-2'           // Trimmomatic adapter file name (adapter directory found inside the container)
    trim_illuminaclip    = '2:30:10:8:True'         // ILLUMINACLIP seed/palindrome parameters
    trim_steps           = ''                       // extra Trimmomatic steps, space separated (legacy: none)
    trim_minlen          = 25                       // Trimmomatic MINLEN

    // ---- Alignment (HISAT2) -----------------------------------------
    hisat2_args          = ''                       // extra HISAT2 arguments, passed after `--` (e.g. --rna-strandness RF); empty = none
    alignment_min_pct    = 50                       // overall alignment rate below which ALIGNMENT_SUMMARY warns (never fails)

    // ---- Filtering (samtools) -----------------------------------------
    mapq                 = 30                       // minimum MAPQ kept (legacy GG: 30)
    remove_chroms        = ''                       // comma list of contigs removed; empty = keep all contigs (GG legacy removed chrM; no effect on the T2T counts)

    // ---- Duplicates (Picard) ------------------------------------------
    optical_duplicate_pixel_distance = 2500         // Picard OPTICAL_DUPLICATE_PIXEL_DISTANCE

    // ---- Strandedness check (RSeQC infer_experiment) -----------------
    infer_experiment_reads = 200000                 // reads sampled per library by infer_experiment.py -s
    strand_call_threshold  = 0.8                    // call forward (reverse) when that fraction of reads is explained by the forward (reverse) pattern; must be in (0.5, 1]

    // ---- Counting (featureCounts) ------------------------------------
    featurecounts_feature_type = 'exon'             // featureCounts -t
    featurecounts_attribute    = 'gene_id'          // featureCounts -g
    featurecounts_args         = ''                 // extra featureCounts arguments; empty

    // ---- Differential expression (DESeq2; off by default: run_deg false = the pipeline ends at the counts table) ----
    // Every default reproduces the legacy step_6_deg_analysis.Rmd of GG_EZH2i_RNAseq, except the volcano colours.
    // Hex colours need quotes in config.yaml ('#' starts a YAML comment). The comparisons, heatmaps, colours and label rules are CSV files
    // whose columns are in README.md ("Differential expression").
    run_deg                    = false  // master switch. true = run DEG_* after the counts table
    deg_counts                 = null   // an existing counts table (Gene + one column per sample): with run_deg, skips ALL upstream steps (no reads, QC or MultiQC); needs deg_metadata or the samplesheet
    deg_metadata               = null   // sample metadata CSV/TSV (one row per sample, column deg_sample_col). null = the samplesheet (excluded rows dropped)
    deg_comparisons            = null   // CSV, one row per comparison: model, design, comparison, contrast columns (required when run_deg)
    deg_heatmaps               = null   // CSV, one row per heatmap: name, model, comparison, ... (null = no heatmaps)
    deg_colors                 = null   // CSV group,color: the colour of each group in the QC and gene plots (null = a default palette)
    deg_label_rules            = null   // CSV pattern,replacement: ordered regex rules that rewrite the sample labels of the heatmaps (null = sample names as they are)
    deg_sample_col             = 'sample_id'  // metadata column holding the sample names (they must equal the count table columns)
    deg_strip_suffix           = ''     // regex removed from the count table column names before matching (legacy counts: '\.R1$'); '' = none
    deg_reference_levels       = ''     // "factor=level,factor=level": the reference level of each design factor, e.g. treatment=LUC_DMSO,drug=DMSO,target=LUC ('' = alphabetical)
    deg_min_count              = 10     // keep a gene when at least deg_min_samples samples have this many counts or more
    deg_min_samples            = 2
    deg_fit_type               = 'parametric'  // DESeq2 dispersion fit: parametric | local | mean
    deg_alpha                  = 0.05   // FDR cut-off, in (0, 1)
    deg_lfc                    = 1      // |log2 fold change| cut-off, >= 0
    deg_lfc_threshold_in_results = false  // true = lfcThreshold = deg_lfc inside results()
    deg_shrink_type            = 'ashr' // log2FC shrinkage: ashr | apeglm (coef contrasts only) | none
    deg_sval_threshold         = 0.005  // s-value cut-off of the shrunk volcano
    deg_transform_method       = 'rlog' // rlog | vst (heatmaps and gene plots)
    deg_transform_blind        = false
    deg_color_down             = '#46627A'  // volcano / MA / heatmap: down, up, not significant, heatmap midpoint (the legacy volcano used #810f7c and gray)
    deg_color_up               = '#8c6bb1'
    deg_color_ns               = 'gray'
    deg_color_mid              = 'white'
    deg_color_by               = ''     // metadata column that colours the QC plots ('' = the first design variable)
    deg_mds_input              = 'logcpm'  // logcpm | counts (counts = raw counts as legacy, dominated by library size)
    deg_mds_label_by           = ''     // metadata column used as the point labels of the MDS plot ('' = none)
    deg_mds_legend_title       = ''     // '' = the colour-by column
    deg_legacy_mds_legend_col  = ''     // legacy bug toggle: a metadata column name makes the MDS legend text come from that column instead of the colour-by column
    deg_cor_method             = 'spearman'  // pearson | spearman | kendall
    deg_label_genes            = ''     // comma list of genes named in the volcano plots
    deg_volcano_xlim           = ''     // "min,max" of every volcano x axis ('' = automatic); a comparison's own xlim column wins
    deg_volcano_ylim           = ''
    deg_volcano_common_xlim    = ''     // limits of the combined volcano figure
    deg_volcano_common_ylim    = ''
    deg_volcano_combined_layout = 'stacked'  // stacked | side
    deg_gene_plot_genes        = ''     // comma list: one expression plot per gene ('' = none)
    deg_gene_plot_x            = ''     // x axis and colour column of the gene plots ('' = deg_color_by, else the first design variable)
    deg_legacy_summary_counts  = false  // legacy bug toggle: true reproduces the legacy up/down counts of the analysis summary
    deg_run_qc                 = true   // QC plots of the count table (DEG_QC)
    deg_run_barplot            = true   // counts per sample bar plot
    deg_run_mds                = true   // MDS plot (pca.pdf)
    deg_run_correlation        = true   // sample correlation heatmap
    deg_run_volcano            = true
    deg_run_volcano_pdfs       = true   // the three multi-page volcano PDFs of a model
    deg_run_volcano_combined   = true   // the combined volcano figure (comparisons with a combined_order)
    deg_run_heatmap            = true   // also needs deg_heatmaps
    deg_run_ma                 = false  // MA plots
    deg_run_gene_plots         = true   // runs only when deg_gene_plot_genes is set

    // ---- Replacing a step's script for one project ----------------------
    // Not declared here on purpose. Every step runs a script from bin/; a
    // project's config.yaml replaces one with a key named after the script
    // (file name without extension), e.g. `featurecounts: utils/featurecounts.sh`,
    // plus optional `<name>_args: "..."` for extra arguments. See
    // stepScripts() in main.nf. Scripts are task inputs, so -resume re-runs
    // only the step whose script changed (and what's downstream of it).
    // (trim and mark_duplicates are switches, so their scripts cannot be replaced by key.)
}

// Base resources first: settings in the profiles below (e.g. test) must override them.
includeConfig 'conf/base.config'

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------
profiles {
    pmacs {
        includeConfig 'conf/pmacs.config'
    }
    local {
        process.executor    = 'local'
        apptainer.enabled    = false
        docker.enabled        = false
    }
    test {
        includeConfig 'conf/test.config'
    }
}


// ---------------------------------------------------------------------------
// Execution provenance — every run records its own report/trace/DAG.
// File names carry the launch timestamp (params.run_timestamp), so a resumed
// run does not overwrite the previous run's trace.
// Pass -with-report/-with-trace/-with-timeline/-with-dag with your own path
// on the command line if you want a copy elsewhere.
// ---------------------------------------------------------------------------
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.metadata_dir}/pipeline_info/execution_timeline_${params.run_timestamp}.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.metadata_dir}/pipeline_info/execution_report_${params.run_timestamp}.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.metadata_dir}/pipeline_info/execution_trace_${params.run_timestamp}.txt"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.metadata_dir}/pipeline_info/pipeline_dag_${params.run_timestamp}.html"
}

// Completion message — defined here (not in main.nf) because config files
// use plain assignment for this hook, sidestepping main.nf's strict script
// parser (which rejects a top-level `workflow.onComplete {}` statement, and
// a version nested inside `workflow {}` resolves `workflow` to null).
workflow.onComplete = {
    // `log` is not bound in config-file closure scope (only in the pipeline
    // script) — use println here, not log.info.
    def status = workflow.success ? 'completed successfully' : 'FAILED'
    println "\nPipeline ${status}. Results in: ${params.outdir}\n"
    // Nextflow's own closing tally ("[FAILED] completed=N failed=M") counts every failed attempt, including
    // attempts that succeeded on retry; say so when the run itself succeeded.
    def failed = workflow.stats?.failedCount ?: 0
    if (workflow.success && failed > 0)
        println "${failed} task attempt(s) failed and succeeded on retry (see ${params.metadata_dir}/pipeline_info/execution_trace_${params.run_timestamp}.txt);\n" +
                "the [FAILED] tally printed below counts these attempts.\n"

    // Strandedness check (QC_STRANDEDNESS_TABLE): a mismatch between the library call and the configured
    // strandedness is a warning only. Read with java.io.File (config scope has no file()); silent when absent.
    try {
        def f = new File("${params.outdir}/qc/strandedness/strandedness.tsv")
        if (f.exists()) {
            def lines = f.readLines().findAll { l -> l.trim() }
            def cols = lines ? lines[0].split('\t', -1).toList() : []
            def need = ['sample_id', 'call', 'configured', 'mismatch'].collect { c -> cols.indexOf(c) }
            if (need.every { i -> i >= 0 }) {
                lines.drop(1).each { l ->
                    def v = l.split('\t', -1).toList()
                    if (v.size() > need.max() && v[need[3]].trim() == 'true')
                        println "WARN: ${v[need[0]]}: library looks ${v[need[1]]}, configured ${v[need[2]]}"
                }
            }
        }
    } catch (Exception e) {
        println "WARN: could not read the strandedness check (${params.outdir}/qc/strandedness/strandedness.tsv): ${e.message}"
    }
}
