/*
 * conf/base.config — default per-process resources and retry policy.
 * Portable across executors (LSF via conf/pmacs.config, or -profile local for testing).
 */

process {
    cpus          = 1
    memory        = 4.GB
    time          = { 1.h * task.attempt }

    // Retry with escalating memory and wall time (both x attempt) on OOM-kill (LSF 137/143) or wall-time
    // kill (140). Also retry (without escalating memory) on any other exit code up to twice — PMACS
    // compute nodes occasionally hit a transient Apptainer container-startup failure (observed: a
    // FIPS/OpenSSL init panic that did not reproduce on retry, on a node where the identical container
    // + bind mount had just succeeded moments before for a different task).
    //
    // Exit code 3 is reserved for "known data problem, retrying can't help"
    // (e.g. an empty BAM, no read pairs in a BAM, an empty featureCounts table, mismatching gene columns)
    // — fail once with a clear message instead of retrying.
    errorStrategy = {
        task.exitStatus in [137, 140, 143] ? 'retry'
            : task.exitStatus == 3        ? 'finish'
            : (task.attempt <= 2 ? 'retry' : 'finish')
    }
    maxRetries    = 3

    // pipefail: without it, `tool ... | tee log` reports tee's exit status, so
    // a crashing tool looks like a success and only surfaces later as a
    // misleading "missing output file" (this is how a real MAGeCK
    // ZeroDivisionError was first hidden).
    shell = ['/bin/bash', '-euo', 'pipefail']

    // Every task's exact command is what a labmate or an agent needs to see
    // to troubleshoot or reproduce it — the legacy pipeline saved this as a
    // batch file next to each step's log; Nextflow's .command.sh is that
    // file already, just left inside its (ephemeral, hash-named) work dir.
    // afterScript runs after the main script/stub regardless of its exit
    // status, so this copy happens even for a step that fails, and .command.sh
    // is already fully interpolated (every ${...} resolved to what actually
    // ran, not the template). Each module then declares `command.sh` as an
    // output with its own publishDir, so it lands in that step's own
    // results/.../log/ next to the step's regular log — see any module for
    // the pattern.
    afterScript = 'cp .command.sh command.sh 2>/dev/null || true'

    // Memory (2026-10-29): peaks of the full GG run (12 libraries, ~30 M pairs each): ALIGN 14.0 GB, MARK_DUPLICATES
    // 12.8 (Java heap = 75% of the request, so it follows the request), TRIM 6.3 (Java), BAM_FILTER 4.6, FASTQC 1.0,
    // GTF_TO_GENEPRED 0.5, FEATURECOUNTS 0.4, the rest below 0.25. Small steps lowered to ~2x their peak (min 1 GB);
    // ALIGN, MARK_DUPLICATES, TRIM, BAM_FILTER and BAM_TO_FASTQ (not measured at full depth) unchanged.
    withName: 'FASTQC_RAW|FASTQC_TRIM' {
        cpus   = 2
        memory = { 2.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withName: 'BAM_TO_FASTQ' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    withName: 'TRIM' {
        cpus   = 8
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withName: 'ALIGN' {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    withName: 'ALIGNMENT_SUMMARY|QC_STRANDEDNESS_TABLE|COUNTS_MERGE|SAMPLESHEET_TSV' {
        cpus   = 1
        memory = { 1.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }
    withName: 'BAM_FILTER' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withName: 'MARK_DUPLICATES' {
        cpus   = 2
        memory = { 16.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    withName: 'GTF_TO_GENEPRED|GENEPRED_TO_BED12' {
        cpus   = 1
        memory = { 1.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }
    withName: 'INFER_STRANDEDNESS' {
        cpus   = 1
        memory = { 1.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withName: 'FEATURECOUNTS' {
        cpus   = 4
        memory = { 2.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withName: 'MULTIQC' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    // Differential expression (run_deg). ESTIMATES from the Docker test on the 12 GG libraries (28,738 genes): not measured on the
    // cluster yet. rlog is slow and memory hungry, and the ashr shrinkage runs once per comparison, so these two get the most room.
    withName: 'DEG_PREPARE|DEG_QC|DEG_MA|DEG_GENE_PLOT|DEG_HEATMAP' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }
    withName: 'DEG_DESEQ2' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withName: 'DEG_RESULTS' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withName: 'DEG_TRANSFORM' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withName: 'DEG_VOLCANO' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
}
