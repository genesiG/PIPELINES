/*
 * conf/docker_tiers.config — cpus and memory per step on this computer. Loaded by conf/docker.config,
 * so it comes after conf/base.config (the cluster values) and before conf/test.config
 * (test still wins with -profile docker,test).
 *
 * The memory requests are measured, not the cluster's: each one is the peak_rss of that step in the full RNA-seq
 * benchmark (benchmark/full, 12 libraries, 56 GB of FASTQ; trace execution_trace_20261029_114629.txt) times 1.25,
 * rounded up, at least 1 GB. The trace's peak_rss column is used, not peak_vmem. The subsample benchmark
 * (benchmark/sub, 1M pairs, 3 traces) is quoted for comparison only: its peaks are smaller (ALIGN 5.4 GB,
 * MARK_DUPLICATES 5.3 GB, TRIM 4.1 GB), which is why the full-depth peak is used.
 * Each entry says where its number comes from: "measured" (benchmark and peak given), "derived" (from the
 * step's command or from a measured step), or "not measured".
 *
 * Java heaps and samtools sort buffers are sized to the request, so that tasks run in parallel up to the cpu count:
 * TRIM and MARK_DUPLICATES get a Java heap of 0.75 x their request (--java-gb, set in modules/local/trim.nf and
 * modules/local/mark_duplicates.nf); ALIGN passes samtools sort -m (ext.sort_mem, bin/align.sh --sort-mem) sized to
 * its request. Trimmomatic, Picard and samtools sort give the same output with a smaller heap or buffer: only the
 * speed and the ceiling change, not the result.
 *
 * cpus: FASTQC takes 1 cpu, so it never blocks an ALIGN. TRIM and BAM_FILTER take 4 (one sample each), MARK_DUPLICATES 2
 * (Picard is single-threaded). ALIGN takes the budget's cpus less 2 (at least 2, at most 8): hisat2 and samtools sort
 * use them, and the rest of the budget runs other samples' small steps beside it.
 *
 * Tiers: the CUT&RUN Docker version picks a per-computer tier here (small, mid, large, from
 * RNA_MAX_MEMORY_MB) because one step's cpus depended on it. In this pipeline no request depends on the
 * tier: ALIGN (8.5 GB) is larger than the budget of a 6 or 8 GB computer, so on such a computer it is capped
 * to the budget (process.resourceLimits, conf/docker.config) and runs alone.
 *
 * A retry ({ ... * task.attempt }) asks for more: base.config retries an OOM-kill (exit 137/143) and any
 * other failure with the attempt number going up, so memory is X, 2X, 3X ...; process.resourceLimits caps
 * it to the budget, so a retry never asks for more than the computer has.
 *
 * Disk-heavy steps (FASTQC, TRIM, BAM_FILTER, MARK_DUPLICATES): run_rnaseq exports RNA_HDD=1 when the inputs or
 * the work folder are on a hard disk, and 0 when they are not. On a hard disk these run at most 2 at a time: several
 * sequential streams at once make a hard disk slower. The launcher's RNA_HDD=1 also applies when the work folder is
 * the Docker volume, whose disk is the drive that holds Docker's data. Without RNA_HDD (the Mac launcher), the older
 * rule applies: 2 at a time when the work folder is the project folder (RNA_WORK_VOLUME=0). Otherwise there is no
 * cap (maxForks 0 = unlimited).
 *
 * (The values are worked out inside each closure: Nextflow config files do not allow variable declarations
 * next to config blocks.)
 */

process {
    // one withName per process name (base.config has the same keys, so these replace its values)
    withName: 'FASTQC_RAW|FASTQC_TRIM' {
        // measured (full, 24 FASTQC tasks per stage): peak 1.0 GB (max 1017 MB), x1.25 = 1.25 GB. Sub: 0.97 GB.
        // One cpu, so FASTQC never takes the cpus an ALIGN needs.
        cpus     = 1
        memory   = { 1.25.GB * task.attempt }
        maxForks = (System.getenv('RNA_HDD') == '1' || (System.getenv('RNA_HDD') == null && System.getenv('RNA_WORK_VOLUME') == '0')) ? 2 : 0   // disk-heavy: 2 at a time on a hard disk, see header
    }
    withName: 'BAM_TO_FASTQ' {
        // not measured at full depth (the full benchmark starts from FASTQ). Sub (one BAM): peak 154 MB,
        // x1.5 = 0.23 GB, rounded up to the 1 GB floor. samtools fastq streams the records, so the peak is
        // not expected to grow with depth (derived from the tool's behaviour, not measured).
        cpus   = 4
        memory = { 1.GB * task.attempt }
    }
    withName: 'TRIM' {
        // measured (full, 12 TRIM tasks): peak 6.2 GB RSS, but that was the Java heap growing to the 6 GB heap of the
        // 8 GB HPC request, not what Trimmomatic needs (its output does not depend on the heap). Java heap = 0.75 x 3 = 2 GB
        // (modules/local/trim.nf). On the Windows desktop (GG_EZH2i full, 2026-10-31) Trimmomatic used about 1.6 cpus
        // whatever -threads it was given, with peak RSS 1.1 GB at a 2 GB request (1 GB heap): 2 cpus and 2 GB, so the
        // trims do not hold cpus that ALIGN needs. Sample-level step.
        cpus     = 2
        memory   = { 2.GB * task.attempt }
        maxForks = (System.getenv('RNA_HDD') == '1' || (System.getenv('RNA_HDD') == null && System.getenv('RNA_WORK_VOLUME') == '0')) ? 2 : 0   // disk-heavy: 2 at a time on a hard disk, see header
    }
    withName: 'ALIGN' {
        // measured (full, 12 ALIGN tasks): peak_rss 13.7 GB at 8 threads. That is hisat2 resident about 5.7 GB plus
        // 8 x 1 GB samtools sort buffers (the default -m 1G). With ext.sort_mem = 256M and 8 threads, the measured peak
        // on the Windows desktop (GG_EZH2i full, 12 tasks, 2026-10-31) was 7 GB, and the count table was byte-identical
        // to the HPC run: the request is 8.5 GB, so two ALIGN tasks fit in a 22 GB budget beside the small steps. bin/align.sh takes --sort-mem from ext.sort_mem (modules/local/align.nf). A retry asks for more.
        // cpus: the budget's cpus less 2 (at least 2, at most 8), so FASTQC and other small steps run beside an alignment.
        // 8 threads reproduce the HPC count table byte for byte; fewer change about 1e-4 of read pairs (ANALYSIS.md).
        cpus     = { Math.min(8, Math.max(((System.getenv('RNA_MAX_CPUS') ?: '2') as int) - 2, 2)) }
        memory   = { 8.5.GB * task.attempt }
        ext.sort_mem = '256M'
    }
    withName: 'ALIGNMENT_SUMMARY|COUNTS_MERGE|QC_STRANDEDNESS_TABLE|SAMPLESHEET_TSV' {
        // measured (full, one task each): peak 11-17 MB; floor 1 GB
        cpus   = 1
        memory = { 1.GB * task.attempt }
    }
    withName: 'BAM_FILTER' {
        // measured (full, 12 BAM_FILTER tasks): peak 4.5 GB, x1.25 = 5.6 GB. Sub: 0.77 GB.
        // samtools sort -m 1G x -@ 4 buffers plus the index and the view stream (bin/bam_filter.sh).
        cpus     = 4
        memory   = { 5.6.GB * task.attempt }
        maxForks = (System.getenv('RNA_HDD') == '1' || (System.getenv('RNA_HDD') == null && System.getenv('RNA_WORK_VOLUME') == '0')) ? 2 : 0   // disk-heavy: 2 at a time on a hard disk, see header
    }
    withName: 'MARK_DUPLICATES' {
        // measured (full): the HPC request of 16 GB gave a 12 GB heap (0.75 x 16) and 12.5 GB RSS, at the heap ceiling, so
        // the peak is not the need. Java heap = 0.75 x 8 = 6 GB (modules/local/mark_duplicates.nf); Picard output does not
        // depend on the heap size, but a smaller heap spills more temporary files to disk (slow on a hard disk).
        // Sub: 5.3 GB RSS. Picard single-threaded: cpus 2 as on the cluster.
        cpus     = 2
        memory   = { 8.GB * task.attempt }
        maxForks = (System.getenv('RNA_HDD') == '1' || (System.getenv('RNA_HDD') == null && System.getenv('RNA_WORK_VOLUME') == '0')) ? 2 : 0   // disk-heavy: 2 at a time on a hard disk, see header
    }
    withName: 'GTF_TO_GENEPRED|GENEPRED_TO_BED12' {
        // measured (full, one task each): GTF_TO_GENEPRED peak 0.46 GB (472 MB), x1.5 = 0.7 GB, rounded up to the 1 GB floor.
        // GENEPRED_TO_BED12 peak 8 MB.
        cpus   = 1
        memory = { 1.GB * task.attempt }
    }
    withName: 'INFER_STRANDEDNESS' {
        // measured (full, 12 tasks): peak 70 MB; floor 1 GB
        cpus   = 1
        memory = { 1.GB * task.attempt }
    }
    withName: 'FEATURECOUNTS' {
        // measured (full, 12 tasks): peak 364 MB, x1.5 = 0.55 GB, rounded up to the 1 GB floor. Sub: 193 MB.
        cpus   = 4
        memory = { 1.GB * task.attempt }
    }
    withName: 'MULTIQC' {
        // measured (full, one task): peak 217 MB, x1.5 = 0.3 GB, rounded up to the 1 GB floor. Sub: 210 MB.
        cpus   = 1
        memory = { 1.GB * task.attempt }
    }
    withName: 'DEG_DESEQ2' {
        // measured (Docker DEG-only run, 12 GG libraries, 28,738 genes; peak 0.7-0.9 GB per task, measured on the cluster version):
        // x1.5 = 1.35 GB, rounded up to 1.5 GB. cpus 2 as on the cluster.
        cpus   = 2
        memory = { 1.5.GB * task.attempt }
    }
    withName: 'DEG_RESULTS' {
        // measured (same run): peak 0.8 GB, x1.5 = 1.2 GB, rounded up to 1.5 GB. cpus 2 as on the cluster.
        cpus   = 2
        memory = { 1.5.GB * task.attempt }
    }
    withName: 'DEG_TRANSFORM' {
        // measured (same run, rlog): peak 0.7 GB, x1.5 = 1.05 GB, rounded up to 1.5 GB.
        cpus   = 1
        memory = { 1.5.GB * task.attempt }
    }
    withName: 'DEG_PREPARE|DEG_QC|DEG_VOLCANO|DEG_HEATMAP|DEG_MA|DEG_GENE_PLOT' {
        // not measured on their own (the same run gives every DEG task below 1 GB): derived, 2 GB request as a safe floor.
        cpus   = 1
        memory = { 2.GB * task.attempt }
    }
}
