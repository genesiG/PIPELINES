/*
 * conf/test.config — reduced resource footprint for smoke-testing the
 * pipeline (e.g. against a tiny synthetic dataset) without waiting on
 * full-size requests. Combine with -profile docker,test (run inside the
 * container); still requires your own -params-file pointing at (small)
 * real input files.
 */

process {
    withName: 'ALIGN|BAM_FILTER|MARK_DUPLICATES|FEATURECOUNTS|INFER_STRANDEDNESS|BAM_TO_FASTQ' { cpus = 1; memory = 2.GB; time = '15.min' }
    withName: 'FASTQC_RAW|FASTQC_TRIM|TRIM|ALIGNMENT_SUMMARY|GTF_TO_GENEPRED|GENEPRED_TO_BED12|QC_STRANDEDNESS_TABLE|COUNTS_MERGE|SAMPLESHEET_TSV|MULTIQC' { cpus = 1; memory = 1.GB; time = '10.min' }
    // Differential expression: estimates from the Docker test, like conf/base.config (the heavy R steps keep a little room)
    withName: 'DEG_DESEQ2|DEG_RESULTS|DEG_TRANSFORM|DEG_VOLCANO' { cpus = 1; memory = 2.GB; time = '15.min' }
    withName: 'DEG_PREPARE|DEG_QC|DEG_MA|DEG_GENE_PLOT|DEG_HEATMAP' { cpus = 1; memory = 1.GB; time = '10.min' }
}
