/*
 * conf/docker.config — running on a personal computer (Windows or Mac),
 * inside the pipeline's Docker image (docker/image.txt). Replaces the cluster
 * version's conf/pmacs.config (LSF + Apptainer).
 *
 * Nextflow itself runs inside the container that run_rnaseq starts, and
 * every step runs right there with the local executor: all tools (HISAT2,
 * samtools, Trimmomatic, Picard, featureCounts, FastQC, MultiQC, RSeQC, R and
 * Python) are installed in that one image, so Nextflow does not start
 * containers of its own (docker.enabled = false — no Docker-in-Docker needed).
 *
 * How parallel steps are handled: on the cluster every task (each sample's
 * FASTQC, TRIM, ALIGN, MARK_DUPLICATES, ...) was its own LSF job on its own
 * node. Here they all share one pool — the run's budget — and the local
 * executor starts a task only when its cpus/memory requests (conf/base.config,
 * conf/docker_tiers.config) still fit next to the ones already running; the rest
 * wait their turn. Results are the same; only the order and the speed differ.
 *
 * The budget: run_rnaseq picks it from the computer's hardware (default:
 * 75% of its memory, always leaving 3 GB to the system, and all cores but one
 * or two; config.yaml's max_cpus / max_memory_gb override it), enforces it as
 * the container's hard limits (docker run --memory, --cpuset-cpus), and hands
 * it to Nextflow below as RNA_MAX_CPUS / RNA_MAX_MEMORY_MB (minus what
 * Nextflow itself needs).
 */

executor {
    name      = 'local'
    cpus      = (System.getenv('RNA_MAX_CPUS') ?: '2') as int
    memory    = "${System.getenv('RNA_MAX_MEMORY_MB') ?: '2048'} MB"
}

process {
    executor       = 'local'
    // A request bigger than the budget is lowered to the budget instead of
    // never being scheduled.
    resourceLimits = [
        cpus:   (System.getenv('RNA_MAX_CPUS') ?: '2') as int,
        memory: "${System.getenv('RNA_MAX_MEMORY_MB') ?: '2048'} MB",
        time:   30.d
    ]
    // Work folder in the project folder (work_volume: false, RNA_WORK_VOLUME=0): that folder is reached through
    // Docker's link to the host's files, measured at about 60 MB/s per stream (about 110 MB/s in all), against
    // about 3 GB/s on Docker's own disk. So each step runs in a scratch folder on Docker's own disk and only its
    // finished outputs cross the link, once. This matters most for ALIGN, whose samtools sort writes 35-54 GB of
    // temporary files per full-depth library (HPC trace), and for BAM_FILTER and MARK_DUPLICATES (sort / Picard
    // temporary files). The scratch folder is deleted when the step ends. Not needed with the Docker work volume.
    scratch        = (System.getenv('RNA_WORK_VOLUME') == '0') ? '/tmp' : false
    // base.config's afterScript copies .command.sh to command.sh (a declared output), but with scratch it runs
    // after the outputs are copied back, in the scratch folder, so command.sh would be missing. Copy it at the
    // start instead, into the scratch folder when there is one (beforeScript runs in the work folder, before the
    // move to scratch). Without scratch this is the same copy as before.
    beforeScript   = 'cp .command.sh "${NXF_SCRATCH:-.}/command.sh" 2>/dev/null || true'
    withName: 'FASTQC_RAW|FASTQC_TRIM' {
        // FastQC's small reads through the link leave it at about 20% cpu; one large copy of its input into the
        // scratch folder first (about 60 MB/s) lets it run at full speed.
        stageInMode = (System.getenv('RNA_WORK_VOLUME') == '0') ? 'copy' : 'symlink'
    }
    withName: 'TRIM' {
        // Trimmomatic is cpu-bound and writes only a few MB/s, so it writes straight to the work folder: no scratch
        // copy of its large outputs on Docker's disk, which keeps that disk's peak use down.
        scratch = false
    }
}

docker.enabled    = false
apptainer.enabled = false

// Cpus and memory per step for this computer (measured on the RNA-seq benchmark). After base.config
// (which it overrides) and before conf/test.config in -profile docker,test.
includeConfig 'docker_tiers.config'
