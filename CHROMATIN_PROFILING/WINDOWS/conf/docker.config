/*
 * conf/docker.config — running on a personal computer (Windows or Mac),
 * inside the pipeline's Docker image (docker/image.txt). Replaces the cluster
 * version's conf/pmacs.config (LSF + Apptainer).
 *
 * Nextflow itself runs inside the container that run_cutandrun starts, and
 * every step runs right there with the local executor: all tools (Trimmomatic,
 * Bowtie2, samtools, Picard, deepTools, MACS3, SEACR, csaw, R and Python) are
 * installed in that one image, so Nextflow does not start containers of its
 * own (docker.enabled = false — no Docker-in-Docker needed).
 *
 * How parallel steps are handled: on the cluster every task (each sample's
 * alignment, each library's peak calling, each heatmap, ...) was its own LSF
 * job on its own node. Here they all share one pool — the run's budget — and
 * the local executor starts a task only when its cpus/memory requests
 * (conf/base.config) still fit next to the ones already running; the rest wait
 * their turn. Results are the same; only the order and the speed differ.
 *
 * The budget: run_cutandrun picks it from the computer's hardware (default:
 * 75% of its memory, always leaving 3 GB to the system, and all cores but one
 * or two; config.yaml's max_cpus / max_memory_gb override it), enforces it as
 * the container's hard limits (docker run --memory, --cpuset-cpus), and hands
 * it to Nextflow below as CNR_MAX_CPUS / CNR_MAX_MEMORY_MB (minus what
 * Nextflow itself needs).
 */

executor {
    name      = 'local'
    cpus      = (System.getenv('CNR_MAX_CPUS') ?: '2') as int
    memory    = "${System.getenv('CNR_MAX_MEMORY_MB') ?: '2048'} MB"
}

process {
    executor       = 'local'
    // A request bigger than the budget is lowered to the budget instead of
    // never being scheduled.
    resourceLimits = [
        cpus:   (System.getenv('CNR_MAX_CPUS') ?: '2') as int,
        memory: "${System.getenv('CNR_MAX_MEMORY_MB') ?: '2048'} MB",
        time:   30.d
    ]
}

docker.enabled    = false
apptainer.enabled = false

// Cpus and memory per step for this computer's memory tier. After base.config
// (which it overrides) and before conf/test.config in -profile docker,test.
includeConfig 'docker_tiers.config'
