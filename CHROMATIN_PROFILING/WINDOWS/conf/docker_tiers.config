/*
 * conf/docker_tiers.config — cpus and memory per step for this computer's
 * memory budget (about 6, 8 or 16 GB). Loaded by conf/docker.config, so it comes
 * after conf/base.config (the cluster values) and before conf/test.config
 * (test still wins with -profile docker,test).
 *
 * The memory requests are measured, not the cluster's: the peak memory of each
 * step in three real pilots: NUC (full depth from FASTQ, 2026-10-27/28), EED (full
 * depth from legacy BAMs, 2026-10-27) and NUC1M (1M-pair subsample, 2026-10-27), times 1.5, rounded up to the next 0.5 GB, at least 1 GB
 * (FASTQC: 0.5 GB, see its entry). Each entry says where its number comes from:
 * "measured" (pilot and peak given), "derived" (from the step's command) or
 * "not measured". Steps not measured at full depth (the BAM_PROCESS parts MARKDUP, DEDUP_SPLIT,
 * BAM_FINALIZE, MACS3, SEACR_CALL and the others marked "not measured") use a
 * derived value or at least 2 GB. Small requests let several steps run side by
 * side inside the budget.
 * cpus are the cluster's, but at most 4 for steps that work on one sample, so
 * several samples run at once. Exceptions: ALIGN takes the budget's cpus less 2 (at least 2),
 * TSS_ENRICHMENT 1, and FASTQC runs at most 2 tasks at a time (maxForks).
 *
 * The tier is chosen from CNR_MAX_MEMORY_MB, the memory the steps may use: the
 * computer's budget less the 1 GB kept for Nextflow (docker/run_in_container.sh
 * already subtracts it). Default 2048 when the variable is not set.
 *   small: the steps have less than 7000 MB  (6 GB computer: about 5 GB)
 *   mid:   the steps have 7000 to 11999 MB   (8 GB computer: about 7 GB)
 *   large: the steps have 12000 MB or more   (16 GB computer: about 15 GB)
 * The cut-offs sit between the budgets of neighbouring computers, so each
 * computer falls into its own tier. Only CSAW and CSAW_CUTOFF_SCAN
 * depend on the tier.
 *
 * A retry ({ ... * task.attempt }) asks for more: base.config retries an OOM-kill
 * (exit 137/143) and any other failure with the attempt number going up, so
 * memory is X, 2X, 3X ...; process.resourceLimits (conf/docker.config) caps it to
 * the budget, so a retry never asks for more than the computer has. The same cap
 * applies to the first request: on the small tier (about 5 GB) BAM_FILTER (7.5 GB)
 * and BAM_PROCESS (6 GB) are both capped to the budget and run one at a
 * time; on the mid tier (about 7 GB) BAM_FILTER is capped to 7 GB and runs alone,
 * and BAM_PROCESS (6 GB) runs only beside a 1 GB task.
 *
 * Concurrency: the local executor starts any queued task that fits in the budget,
 * so small side-branch QC tasks would refill the memory that BAM_PROCESS and BAM_FILTER
 * need and starve the critical path. So PICARD_ELC, PRESEQ, LIBCOMPLEXITY_FRAGS,
 * FINGERPRINT and TSS_ENRICHMENT run one task at a time (maxForks = 1): 1 + 1 + 1.5
 * + 1.5 + 1.5 = 6.5 GB at most, which leaves at least 6.5 GB of the 13 GB for the steps (a 14 GB
 * container limit, what a 16 GB Docker VM allows, less 1 GB for Nextflow) for the BAM chain (maxForks 2 each would hold 13 GB). FASTQC keeps
 * maxForks 2.
 *
 * Disk-heavy steps (BAM_FILTER, BAM_PROCESS): the launcher
 * exports CNR_WORK_VOLUME=1 when the work folder is the Docker volume and 0 when it is
 * the project folder. With 0 (a hard disk, which may thrash) these run at most 2 at a
 * time: two big sequential BAM streams at once is what a hard disk copes with. With 1
 * (the volume, on Docker's own disk) there is no cap (maxForks 0 = unlimited), because
 * memory is the limit there.
 *
 * (The tier is worked out inside each closure: Nextflow config files do not
 * allow variable declarations next to config blocks.)
 */

process {
    // one withName per process name (base.config has the same keys, so these replace its values)
    withName: 'FASTQC' {
        // measured peak 0.19 GB; fastqc runs a JVM with -Xmx250m per thread (2 cpus = 500 MB heap, not all touched).
        // maxForks 2: with the project on a hard disk 4 at once were disk-bound (about 20% cpu each) and
        // delayed TRIM by 80 min; two at a time leave cpus and disk for TRIM and ALIGN.
        // cpus 1: each task reads one file, so a second thread does nothing, and ALIGN takes the
        // budget's cpus less 2: two FASTQC at 2 cpus each kept ALIGN waiting until every FASTQC had
        // finished (GG_CBX2 2026-10-28: 4.5 h with the cpus idle)
        maxForks = 2
        cpus     = 1
        memory   = { 0.5.GB * task.attempt }
    }
    withName: 'TRIM' {
        cpus   = 4
        memory = { 1.5.GB * task.attempt }   // measured NUC 2026-10-27, peak 763 MB, x1.5 = 1.1 GB, rounded to 1.5 GB
    }
    withName: 'ALIGN' {
        // bowtie2 threads (bin/align.sh -p) = the budget's cpus less 2 (at least 2), so FASTQC and
        // other small steps can run beside an alignment
        // measured NUC 2026-10-27, peak 3.9 GB (3994 MB, the bowtie2 index). x1.5 would be 6 GB, but the
        // peak is the index (deterministic, not read-dependent), bowtie2 runs one at a time anyway, and
        // 6 GB would stop BAM_FILTER (7.5 GB) fitting beside it in a 13 GB budget. Fixed at 4.5 GB, no retry escalation
        cpus   = { Math.max(((System.getenv('CNR_MAX_CPUS') ?: '2') as int) - 2, 2) }
        memory = 4.5.GB
    }
    withName: 'BAM_FILTER' {
        cpus   = 4
        memory = { 7.5.GB * task.attempt }   // measured NUC 2026-10-27, peak 4915 MB (4.8 GB: samtools sort -m 1G -@ 4 = 4 GB buffers + about 0.8 GB), x1.5 = 7.2 GB, rounded to 7.5 GB. The first attempt at 2 GB was OOM-killed on all 16 libraries
        maxForks = (System.getenv('CNR_WORK_VOLUME') == '0') ? 2 : 0   // disk-heavy: 2 at a time on a hard disk, see header
    }
    // BAM_PROCESS = the fused MARKDUP + DEDUP_SPLIT + BLACKLIST_FILTER + BAM_FINALIZE (one task). Fused value = max
    // of the parts: cpus = max(MARKDUP 1, DEDUP_SPLIT 4, BLACKLIST_FILTER 2 [base.config], BAM_FINALIZE 4) = 4;
    // memory = max(MARKDUP 4 or 5, DEDUP_SPLIT 6, BLACKLIST_FILTER 1, BAM_FINALIZE 6) = 6 GB x attempt. So the
    // MARKDUP small / other tier split no longer matters (its Picard heap is the request less 2 GB = 4 GB). The
    // per-part comments of the four steps, kept as they were:
    //   MARKDUP: bin/markdup.sh gives Picard a heap of memory minus 2 GB: 2 GB (small tier) or 3 GB (mid and large);
    //   a retry raises it (10 GB request = 8 GB heap on mid and large)
    //   derived, not measured at full depth (NUC1M 1M-pair pilot peak 1.5 GB with an 8 GB heap): Picard
    //   MarkDuplicates spills to disk (MAX_RECORDS_IN_RAM default), and a 3 GB heap is its usual need
    //   DEDUP_SPLIT: derived: samtools sort -m 1G x -@ 4 (+0.8 GB measured overhead in BAM_FILTER), +25%; not measured at full depth (NUC1M 1M-pair: 0.53 GB)
    //   BLACKLIST_FILTER: floor 1 GB: bedtools pairtobed streams a name-sorted BAM, NUC1M 1M-pair peak 27 MB, depth-independent
    //   BAM_FINALIZE: derived: samtools sort -m 1G x -@ 4 (+0.8 GB measured overhead in BAM_FILTER), +25%; not measured at full depth (NUC1M 1M-pair: 0.53 GB)
    withName: 'BAM_PROCESS' {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        maxForks = (System.getenv('CNR_WORK_VOLUME') == '0') ? 2 : 0   // disk-heavy: 2 at a time on a hard disk, see header
    }
    withName: 'BAM_PREALIGNED' {
        // floor 1 GB: measured EED 2026-10-27, peak 27.5 MB
        memory = { 1.GB * task.attempt }
    }
    withName: 'QC_ALIGNMENT_TABLE' {
        memory = { 1.GB * task.attempt }
    }
    withName: 'QC_ALIGNMENT_PLOT' {
        memory = { 1.GB * task.attempt }
    }
    withName: 'QC_FRAGMENT_SIZES_TABLE' {
        cpus   = 4
        // measured NUC 2026-10-27 peak 459 MB with one worker; now 4 forked workers (mclapply), shared pages, 2 GB
        memory = { 2.GB * task.attempt }
    }
    withName: 'QC_FRAGMENT_SIZES_PLOT' {
        memory = { 1.GB * task.attempt }
    }
    withName: 'LIBCOMPLEXITY_FRAGS' {
        // side branch, one at a time (see header). measured NUC 2026-10-27, peak 1024 MB, x1.5 = 1.5 GB.
        // --sort-mem = max(1, request in GB / 2) G, integer GB, so the sort buffer stays 1G at 1.5 GB request
        maxForks = 1
        memory = { 1.5.GB * task.attempt }
    }
    withName: 'PICARD_ELC' {
        // bin/picard_elc.sh heap = request - 2 GB (at least 1 GB)
        // side branch, one at a time (see header). measured NUC 2026-10-27, peak 647 MB, x1.5 = 0.95 GB, rounded to 1 GB.
        // The heap is 1 GB either way (max(1, request - 2))
        maxForks = 1
        memory = { 1.GB * task.attempt }
    }
    withName: 'QC_LIBCOMPLEXITY_TABLE' {
        memory = { 1.GB * task.attempt }
    }
    withName: 'QC_LIBCOMPLEXITY_PLOT' {
        memory = { 1.GB * task.attempt }
    }
    withName: 'PRESEQ' {
        // side branch, one at a time (see header). measured NUC 2026-10-27, peak 21 MB; floor 1 GB
        maxForks = 1
        memory = { 1.GB * task.attempt }
    }
    withName: 'QC_PRESEQ_PLOT' {
        memory = { 1.GB * task.attempt }
    }
    withName: 'FINGERPRINT' {
        // side branch, one at a time (see header). measured EED 2026-10-27, peak 719 MB, x1.5 = 1.05 GB, rounded to 1.5 GB
        cpus   = 4
        maxForks = 1
        memory = { 1.5.GB * task.attempt }
    }
    withName: 'CORRELATION' {
        memory = { 2.GB * task.attempt }   // measured NUC 2026-10-27 (16 libraries, full depth), peak 1.3 GB; x1.25-1.5, rounded. The request only schedules tasks here: too high queues the task, too low risks OOM
    }
    withName: 'FRIP' {
        memory = { 1.GB * task.attempt }
    }
    withName: 'QC_FRIP_TABLE' {
        memory = { 1.GB * task.attempt }
    }
    withName: 'TSS_ENRICHMENT' {
        // bin/qc_tss_enrichment.py (pyBigWig, one thread). measured EED 2026-10-27, peak 812 MB (the old 0.11 GB
        // came from the 1M pilot), x1.5 = 1.2 GB, rounded to 1.5 GB. Side branch, one at a time (see header)
        cpus   = 1
        maxForks = 1
        memory = { 1.5.GB * task.attempt }
    }
    withName: 'QC_TSS_TABLE' {
        memory = { 1.GB * task.attempt }
    }
    withName: 'QC_PEAK_STATS' {
        memory = { 1.GB * task.attempt }
    }
    withName: 'MULTIQC' {
        memory = { 1.GB * task.attempt }
    }
    withName: 'REPORT' {
        memory = { 1.GB * task.attempt }
    }
    withName: 'CHIPSEQSPIKEINFREE' {
        // cpus also set the BiocParallel workers in bin/norm_chipseqspikeinfree.R,
        // and the memory sums the forked workers
        cpus   = 2
        memory = { 3.5.GB * task.attempt } // grows with depth; a retry asks for more
    }
    withName: 'SPIKEIN' {
        memory = { 1.GB * task.attempt }
    }
    withName: 'BIN_COUNTS' {
        // csaw counts every library in one task; cpus = BiocParallel workers. measured NUC 2026-10-27 (16 libraries,
        // full depth), peak 2.4 GB. The old 7 GB request kept it queued for 2.7 h: the local executor starts a task
        // only when its whole request is free, and smaller tasks kept taking the memory. 4 GB = 2.4 x 1.5, rounded
        // up for projects with more libraries; a retry asks for more
        cpus   = 2
        memory = { 4.GB * task.attempt }
    }
    withName: 'TMM' {
        cpus   = 1
        memory = { 1.5.GB * task.attempt }   // measured NUC 2026-10-27 (16 libraries, full depth), peak 0.81 GB; x1.25-1.5, rounded. The request only schedules tasks here: too high queues the task, too low risks OOM
    }
    withName: 'NORM_CPM|NORM_COMBINE' {
        cpus   = 1
        memory = 1.GB
    }
    withName: 'NORM_QC' {
        cpus   = 1
        memory = { 1.GB * task.attempt }   // measured NUC 2026-10-27 (16 libraries, full depth), peak 0.22 GB; x1.25-1.5, rounded. The request only schedules tasks here: too high queues the task, too low risks OOM
    }
    withName: 'REPLICATE_CORRELATION' {
        cpus   = 1
        memory = { 1.GB * task.attempt }   // measured NUC 2026-10-27 (16 libraries, full depth), peak 0.24 GB; x1.25-1.5, rounded. The request only schedules tasks here: too high queues the task, too low risks OOM
    }
    withName: 'REPLICATE_CORRELATION_PLOT' {
        cpus   = 1
        memory = { 1.GB * task.attempt }   // measured NUC 2026-10-27 (16 libraries, full depth), peak 0.26 GB; x1.25-1.5, rounded. The request only schedules tasks here: too high queues the task, too low risks OOM
    }
    withName: 'BIGWIG' {
        cpus   = 4
        memory = { 1.5.GB * task.attempt } // measured EED 2026-10-27, peak 929 MB, x1.5 = 1.4 GB, rounded to 1.5 GB
    }
    withName: 'BIGWIG_LOG2RATIO' {
        cpus   = 4
        memory = { 1.5.GB * task.attempt } // not measured
    }
    withName: 'CSAW' {
        // 1 cpu on the small tier, 2 on the mid and large tiers
        cpus   = { ((System.getenv('CNR_MAX_MEMORY_MB') ?: '2048') as int) < 7000 ? 1 : 2 }
        memory = { 8.GB * task.attempt }   // measured NUC 2026-10-27 (16 libraries, full depth), peak 6.3 GB; x1.25-1.5, rounded. The request only schedules tasks here: too high queues the task, too low risks OOM
    }
    withName: 'CSAW_CUTOFF_SCAN' {
        // 1 cpu on the small tier, 2 on the mid and large tiers
        cpus   = { ((System.getenv('CNR_MAX_MEMORY_MB') ?: '2048') as int) < 7000 ? 1 : 2 }
        memory = { 4.GB * task.attempt }   // not measured; same as CSAW
    }
    withName: 'CLASSIFY_REGIONS' {
        cpus   = 1
        memory = { 1.5.GB * task.attempt } // grows with depth; a retry asks for more
    }
    withName: 'CLASSIFY_REGIONS_PLOT' {
        memory = { 1.GB * task.attempt }
    }
    withName: 'MACS3' {
        memory = { 5.GB * task.attempt }   // measured NUC 2026-10-27 (16 libraries, full depth), peak 4.0 GB; x1.25-1.5, rounded. The request only schedules tasks here: too high queues the task, too low risks OOM
    }
    withName: 'SEACR_BEDGRAPH' {
        memory = { 3.GB * task.attempt }
    }
    withName: 'SEACR_CALL' {
        memory = { 2.GB * task.attempt }   // not measured; at least 2 GB
    }
    withName: 'SEACR_CONSENSUS' {
        memory = { 1.GB * task.attempt }
    }
    withName: 'COMPUTEMATRIX' {
        memory = { 1.5.GB * task.attempt }   // measured NUC 2026-10-27 (16 libraries, full depth), peak 0.66 GB; x1.25-1.5, rounded. The request only schedules tasks here: too high queues the task, too low risks OOM
    }
    withName: 'COMPUTEMATRIX_CLUSTERED' {
        memory = { 1.GB * task.attempt }
    }
    withName: 'HEATMAP_CLUSTER' {
        memory = { 1.GB * task.attempt }
    }
    withName: 'PLOTHEATMAP' {
        memory = { 1.5.GB * task.attempt }   // measured NUC 2026-10-27 (16 libraries, full depth), peak 0.60 GB; x1.25-1.5, rounded. The request only schedules tasks here: too high queues the task, too low risks OOM
    }
    withName: 'HEATMAP_LIMITS' {
        memory = { 1.GB * task.attempt }
    }
    withName: 'BUILD_MATRIX' {
        cpus   = 1
        memory = { 3.5.GB * task.attempt } // grows with depth; a retry asks for more
    }
    withName: 'PLOT_ENRICHED' {
        memory = { 1.5.GB * task.attempt }
    }
    withName: 'TRACKS_INI' {
        memory = { 1.GB * task.attempt }
    }
    withName: 'TRACKS_LIMITS' {
        memory = { 1.GB * task.attempt }
    }
    withName: 'PEAK_QC_REGIONS' {
        memory = { 1.GB * task.attempt }
    }
    withName: 'PYGENOMETRACKS' {
        memory = { 1.GB * task.attempt }
    }
    withName: 'PEAK_ANNOTATION' {
        memory = { 4.5.GB * task.attempt } // grows with depth; a retry asks for more
    }
    withName: 'INTERSECT' {
        memory = { 1.GB * task.attempt }
    }
    withName: 'NORM_QC_PLOT' {
        memory = { 1.GB * task.attempt }
    }
}
