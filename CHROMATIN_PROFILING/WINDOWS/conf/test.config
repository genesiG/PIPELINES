/*
 * conf/test.config — reduced resource footprint for smoke-testing the
 * pipeline (e.g. against a tiny synthetic dataset) without waiting on
 * full-size requests. Combine with -profile docker,test (run inside the
 * container); still requires your own -params-file pointing at (small)
 * real input files.
 */

process {
    withName: 'FASTQC|TRIM|BAM_FILTER|BAM_PREALIGNED|QC_ALIGNMENT_TABLE|QC_ALIGNMENT_PLOT|QC_FRAGMENT_SIZES_TABLE|QC_FRAGMENT_SIZES_PLOT|LIBCOMPLEXITY_FRAGS|PICARD_ELC|QC_LIBCOMPLEXITY_TABLE|QC_LIBCOMPLEXITY_PLOT|PRESEQ|QC_PRESEQ_PLOT|FINGERPRINT|FRIP|QC_FRIP_TABLE|TSS_ENRICHMENT|QC_TSS_TABLE|QC_PEAK_STATS|MULTIQC|REPORT|SPIKEIN|NORM_CPM|NORM_COMBINE|NORM_QC|REPLICATE_CORRELATION|REPLICATE_CORRELATION_PLOT|BIGWIG_LOG2RATIO|MACS3|SEACR_BEDGRAPH|SEACR_CALL|SEACR_CONSENSUS|INTERSECT|TRACKS_INI|PYGENOMETRACKS|PLOTHEATMAP|COMPUTEMATRIX|COMPUTEMATRIX_CLUSTERED|NORM_QC_PLOT|HEATMAP_CLUSTER|CLASSIFY_REGIONS_PLOT|HEATMAP_LIMITS|TRACKS_LIMITS' { cpus = 1; memory = 1.GB; time = '10.min' }
    withName: 'ALIGN|BAM_PROCESS|BIN_COUNTS|CORRELATION|CHIPSEQSPIKEINFREE|TMM|BIGWIG|CSAW|CSAW_CUTOFF_SCAN|BUILD_MATRIX|PLOT_ENRICHED|PEAK_ANNOTATION|CLASSIFY_REGIONS|PEAK_QC_REGIONS' { cpus = 1; memory = 2.GB; time = '15.min' }
}
