/*
 * CUTANDRUN — reproducible CUT&RUN / CUT&Tag pipeline, Docker version
 * (Windows / Mac personal computers). Same pipeline as the cluster version,
 * run inside one Docker image instead of LSF + Apptainer.
 *
 * Reusable across projects/labmates: nothing project-specific lives here.
 * Each project supplies its own config.yaml (see examples/config.yaml) and
 * runs with `run_cutandrun`, which starts the container and, inside it,
 * runs nextflow with the -profile docker of this file:
 *   nextflow run /pipeline -profile docker -params-file config.yaml -resume
 * (docker/run_in_container.sh). Don't call nextflow yourself.
 *
 * Directory convention (shared across all lab pipelines, not just this one):
 *   samplesheet.csv, norm_runs.csv, peaksets.csv — your own small input CSVs,
 *                                  live at the project root (config.yaml too)
 *   original_data/fastq/        — per-sample FASTQ(s): supplied directly by the user
 *                                  (this pipeline has no demultiplexing step);
 *                                  samplesheet.csv may also point at FASTQs elsewhere
 *   metadata/                   — pipeline-generated run metadata: Nextflow's own
 *                                  execution report/trace/timeline/DAG,
 *                                  and .nextflow.log (NOT this pipeline's own inputs —
 *                                  kept for consistency with pipelines that do populate
 *                                  it with their own generated metadata)
 *   intermediate_files/         — large per-sample intermediates (trimmed FASTQ, aligned and filtered BAMs, bedGraphs, bin counts), written only when publish_intermediates is true
 *   results/<step>/             — final outputs, one subfolder per pipeline step
 *
 * Not relocatable into metadata/: .nextflow/ (Nextflow's own resume cache +
 * history) always lives at the directory nextflow was launched from — no
 * flag moves it independently, and moving the whole launch directory would
 * break every relative path in config.yaml. Verified empirically, not
 * assumed — see the pipeline's git history for the test.
 */

manifest {
    name            = 'CUTANDRUN'
    description     = 'Reproducible CUT&RUN / CUT&Tag pipeline (trim -> align -> filter -> QC -> normalise -> bigWig -> csaw/MACS3/SEACR), Docker version for Windows/Mac'
    author          = 'Rephill Lab'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=26.04.0'
    version         = '0.1.0'
}

// ---------------------------------------------------------------------------
// Default parameters — override per-project via -params-file config.yaml
// (do NOT edit these defaults for a specific project; use your own config.yaml)
// ---------------------------------------------------------------------------
params {
    // ---- Project identity ---------------------------------------------
    project_name        = 'my_cutandrun'   // prefix of the QC report and other project-level outputs

    // ---- Inputs (CSVs live at the project root) -------------------------
    samplesheet          = 'samplesheet.csv'   // one row per library: sample_id,fastq_1,fastq_2,bam,antibody,condition,replicate,control_id,group,norm_run,exclude
    norm_runs            = 'norm_runs.csv'     // one row per normalisation run: norm_run,method,bin_size,cutoff,max_turns
    peaksets             = 'peaksets.csv'      // one row per csaw peak set: peakset,target_group,control_group,small_filt,large_filt,merge_bp,max_width,fdr,lfc (threshold cells may be blank: see csaw_defaults and csaw_<col> below)
    classifications      = null   // region classifications CSV: one row per classification (classification,regions,ref_group,treat_group,norm_run,lfc_retained,lfc_lost,fdr; blank cells take classify_* below; run_classify)
    heatmaps             = null   // heatmaps CSV: one row per heatmap (heatmap,regions,samples,labels,window_bp,bin_bp,sort_using,cluster_k,z_min,z_max,y_max,colors,engine; optional cluster_samples,cluster_labels,legend_title)
    tracks               = null   // tracks CSV: one row per track set (track_set,locus_or_gene,flank,samples,labels,colors,max_value,beds,scalebar; optional log2ratio)
    intersects           = null   // intersects CSV: one row per overlap (name,bed_a,bed_b,label_a,label_b,min_overlap,reciprocal[,output])
    // Not used by this pipeline version: the FASTQs are named in the samplesheet (fastq_1 / fastq_2).
    fastq_dir            = null

    // ---- This computer's resources (Docker version only) ------------------
    // null = the default budget (what the pipeline can use, docker/requirements.conf
    // max_useful_memory_gb, but at most 75% of the computer's memory, leaving at
    // least 3 GB to the system; all CPU cores but 1-2; never more than Docker
    // Desktop allows). Read by run_cutandrun, which enforces the budget as the
    // container's limits; conf/docker.config hands it to the scheduler.
    max_cpus              = null
    max_memory_gb         = null

    // ---- Output / directory convention -------------------------------
    // See the directory-convention comment at the top of this file.
    outdir               = './results'
    metadata_dir         = './metadata'
    intermediate_dir     = './intermediate_files'
    // true = also publish the large intermediates to intermediate_dir (trimmed FASTQs, unfiltered aligned BAMs,
    // filtered BAMs, SEACR bedGraphs, BIN_COUNTS tables). false = they stay only in the Nextflow work folder
    // (kept while keep_work is true), which saves a full extra copy on disk each. The markdup and name-sorted
    // BAMs of BAM_PROCESS are never kept: deleted in the task.
    publish_intermediates = false

    // 'auto' = hard links from the work folder when possible (the work folder is inside the project),
    // else copies; resolved by docker/run_in_container.sh, which passes --publish_mode link|copy.
    // An explicit value in config.yaml wins. Accepted explicit values: copy, link, symlink, rellink
    // (symlink/rellink make results/ point into the work folder: keep_work is then forced on).
    publish_mode         = 'auto'
    // true (default) = keep metadata/work and metadata/.nextflow after a successful run, so the next
    // run resumes. false = delete them after a successful run (the next run then recomputes every
    // step). Failed or stopped runs always keep them. Safe with copy and link, not with symlink/rellink.
    keep_work            = true

    // ---- Assay and reference -----------------------------------------
    experiment           = 'cutandrun'   // cutandrun | cutandtag (selects the trimmomatic adapter file)
    genome_index         = null   // bowtie2 index PREFIX of the combined target + spike-in genome
    chrom_sizes          = null   // chrom.sizes of the combined genome
    blacklist            = null   // blacklist BED (pair-aware removal)
    gtf                  = null   // gene annotation GTF
    tss_bed              = null   // TSS BED for TSS enrichment; fallback only, used (and required) when gtf is unset
    spike_prefix         = 'ecoli_chr'   // contig-name prefix of the spike-in genome
    mito_chrom           = 'chrM'        // mitochondrial contig name (dropped from the target BAM)
    effective_genome_size = 3100000000   // MACS3 -g / bamCoverage RPGC (T2T-CHM13)
    paired_end           = true          // paired-end only in stage 1a (startup error otherwise)

    // ---- Trimming and alignment --------------------------------------
    trim                 = true    // run trimmomatic before alignment
    trim_minlen          = 25      // trimmomatic MINLEN
    bowtie2_mode         = 'local' // local | end_to_end
    bowtie2_minins       = null    // bowtie2 -I; null = omit (bowtie2 default 0)
    bowtie2_maxins       = null    // bowtie2 -X; null = omit (bowtie2 default 500); also csaw max.frag fallback when csaw_max_frag is null (500 if both null)
    mapq                 = 30      // minimum MAPQ kept

    // ---- Duplicates --------------------------------------------------
    remove_duplicates    = true    // remove duplicates from target BAMs (IgG always deduplicated)
    spikein_dedup        = true    // remove duplicates from the spike-in BAM

    // ---- Normalisation -----------------------------------------------
    normalisation        = 'chipseqspikeinfree'   // chipseqspikeinfree | spikein | tmm | cpm (informational; norm_run in samplesheet decides)
    tmm_bin_size         = 10000   // genomic bin size for TMM
    // Every norm_run also computes these methods besides its primary (norm_runs.csv `method`); only the primary feeds bigWigs and classification.
    norm_methods         = 'chipseqspikeinfree,tmm,cpm'   // comma list of chipseqspikeinfree, tmm, cpm; '' = primary only
    norm_spikein         = false   // also compute physical spike-in factors as a diagnostic (runs with pre-aligned BAMs: unavailable)
    csif_bin_size        = 10000   // ChIPseqSpikeInFree settings when it is a diagnostic and the norm_runs.csv cell is blank
    csif_cutoff          = 1.2
    csif_max_turns       = 0.99
    norm_qc_min_count    = 20      // MA pair: minimum fragments summed over the two libraries
    norm_qc_prior        = 0.5     // prior count of the MA log2 CPM (the reference lines do not depend on it)
    norm_qc_panels_per_page = 12   // MA panels per SVG page
    // Replicate concordance of libraries of the same group (csaw bin counts, no BAM re-read)
    run_replicate_correlation = true
    repcor_bin_size      = null    // null = tmm_bin_size
    repcor_prior         = 2       // prior count of the Pearson log2 CPM
    repcor_signal_frac   = 0.10    // fraction of bins (highest mean signal) of the signal-bin metrics
    run_deeptools_correlation = true   // deepTools all-sample Spearman heatmap (qc/correlation/)

    // ---- bigWig tracks -----------------------------------------------
    bigwig_bin_size      = 10      // bamCoverage --binSize
    bigwig_extend_reads  = true    // bamCoverage --extendReads (paired-end fragments)
    bigwig_units         = 'rpkm'  // rpkm | cpm | none
    run_log2ratio        = false   // also write target-vs-control log2ratio bigWigs

    // ---- Peaks: csaw (default) ---------------------------------------
    call_peaks           = true    // master switch: false = no peak calling at all (csaw, csaw cutoff scan, MACS3, SEACR, FRiP, peak QC, peak annotation); bigWigs, normalisation, QC, heatmaps and tracks still run
    run_csaw             = true
    csaw_window          = 150     // csaw window width (bp)
    csaw_spacing         = 50      // csaw window spacing (bp)
    csaw_bin             = 10000   // csaw background bin size (bp)
    csaw_norm_bins       = 'background'   // background | all
    run_csaw_cutoff_scan = false   // optional post-hoc diagnostic; never feeds thresholds
    csaw_scan_small_grid = '1,1.5,2,3'     // small-filter grid for the cutoff scan
    csaw_scan_large_grid = '0.5,1,1.5,2'   // large-filter grid for the cutoff scan
    // Thresholds of a blank peaksets.csv cell: csaw_defaults[antibody of target_group][col], then csaw_<col>.
    csaw_small_filt      = 3       // small_filt fallback
    csaw_large_filt      = 1.5     // large_filt fallback
    csaw_merge_bp        = 50      // merge_bp fallback (bp)
    csaw_max_width       = 0       // max_width fallback (bp); 0 = no limit
    csaw_fdr             = 0.05    // fdr fallback
    csaw_lfc             = 1       // lfc fallback
    // per-antibody fallbacks, keys = samplesheet antibody of the target_group (user decision 2026-10-23: the
    // CBX2 / EED settings). A csaw_defaults block in config.yaml REPLACES this whole map (list every antibody you need).
    csaw_defaults        = [K27me3: [small_filt: 3, large_filt: 1.5, merge_bp: 50],
                            K27me2: [small_filt: 2, large_filt: 1, merge_bp: 50]]
    csaw_large_window    = 2000    // csaw large window width (bp)
    csaw_large_spacing   = 500     // csaw large window spacing (bp)
    csaw_bg_max_enrich   = 1       // background bin enrichment cap
    csaw_count_filter    = 10      // minimum summed count per window
    csaw_max_frag        = null    // max.frag (bp); null = bowtie2_maxins, else 500
    csaw_lfc_from        = 'combined'  // combined (legacy: combined-test logFC) | best (best-window logFC)
    csaw_disjoint_regions = false  // true = make merged regions disjoint (false = legacy)

    // ---- Peaks: region classification (optional) ----------------------
    run_classify         = false   // classify the regions of classifications CSV into retained / lost / unclassified
    classify_lfc_retained = -1     // logFC threshold for retained (fallback for a blank classifications.csv cell)
    classify_lfc_lost    = -2      // logFC threshold for lost (fallback)
    classify_fdr         = 0.05    // FDR threshold (fallback)

    // ---- Peak calling mode per histone mark (MACS3 and SEACR) ---------
    // broad_marks: marks called as broad (comma list, case-insensitive, with or without the H3/H4 prefix: K27me3 = H3K27me3).
    // Sources: ENCODE histone ChIP-seq broad list https://www.encodeproject.org/chip-seq/histone/ (H3K27me3, H3K36me3,
    // H3K4me1, H3K79me2, H3K79me3, H3K9me1, H3K9me2, H4K20me1, H3F3A) plus H3K27me2 (lab request) and H3K9me3 (an ENCODE
    // "exception" that St. Jude treats as broad). Any other antibody is narrow. Used by macs3_broad = auto and seacr_mode = auto.
    broad_marks          = 'H3K27me3,H3K27me2,H3K36me3,H3K4me1,H3K79me2,H3K79me3,H3K9me1,H3K9me2,H3K9me3,H4K20me1,H3F3A'

    // ---- Peaks: MACS3 (default on) ------------------------------------
    // run_macs3 / run_seacr: null (not set) = ON when every target has a control_id, else skipped with a warning;
    // true = on, a target without a control stops the run; false = off. The documented default is true.
    run_macs3            = null
    macs3_broad          = 'auto'      // auto (broad for the marks of broad_marks, narrow otherwise) | true | false (force every group)
    macs3_qvalue         = 0.01
    macs3_broad_cutoff   = 0.1         // --broad-cutoff of the broad groups

    // ---- Peaks: SEACR (default on) ------------------------------------
    // LAB POLICY: SEACR has no broad mode. relaxed = threshold between the knee and the peak of the total-signal curve
    // (more, wider peaks), stringent = the peak of the curve. auto = relaxed for the marks of broad_marks, stringent otherwise.
    run_seacr            = null        // null = on when every target has a control_id (see run_macs3)
    seacr_mode           = 'auto'      // auto | relaxed | stringent
    seacr_min_replicates = 2
    seacr_reciprocal_overlap = 0.5

    // ---- Samples kept but skipped by all core steps -------------------
    // Comma list of `group` values (samplesheet.csv) skipped by QC, normalisation, bigWigs and peaks.
    skip_groups          = ''

    // ---- Report ----------------------------------------------------------
    run_report           = true
    heatmap_seed         = 42      // seed of the heatmap k-means clustering
    // Heatmap styling (defaults = the values used before these params existed; deepTools engine only)
    heatmap_reference_point   = 'center'      // center | TSS | TES
    heatmap_missing_as_zero   = true          // false = missing data is not set to zero
    heatmap_average_type_bins = 'mean'        // computeMatrix --averageTypeBins
    heatmap_plot_type         = 'se'          // summary plot line type
    heatmap_average_type_summary = 'mean'     // summary plot average
    heatmap_height            = 12            // figure height
    heatmap_width             = 3.5           // figure width
    heatmap_x_label           = 'distance (bp)'
    heatmap_ref_label         = 'peak center'
    heatmap_y_label           = null          // null = normalised <bigwig_units>
    heatmap_legend_location   = 'none'

    // ---- Heatmaps, genome tracks, peak annotation, intersects ---------------
    run_heatmaps         = false   // heatmaps CSV (heatmaps): matrices, clustering, heatmap plots
    run_tracks           = false   // tracks CSV (tracks): pyGenomeTracks figures
    tracks_width         = 15      // pyGenomeTracks figure width (cm)
    tracks_dpi           = 600     // pyGenomeTracks figure resolution (dpi)
    tracks_max_value_default = 'shared'   // max_value of a blank tracks.csv entry: shared (group by antibody) | auto | number
    tracks_limit_stat    = 'mean_bins'   // y-max statistic of shared (group:) track limits: mean_bins (max over the per-bin means, number_of_bins bins; EED rule) | max_bin (max over the locus window of the bigWig's own bins; CBX2 rule)
    // Track styling (defaults = the values used before these params existed)
    track_number_of_bins = 700     // number_of_bins of the sample bigWig tracks
    track_height         = 1.0     // height of the sample bigWig tracks
    track_fontsize       = 14      // sample track titles (accepted; bigWig track titles use pyGenomeTracks' own size, so it no longer changes them)
    track_bed_height     = 0.1     // height of BED tracks
    track_bed_color      = '#8c96c6'   // default colour of BED tracks (tracks.csv bed_colors overrides)
    track_scalebar_fontsize = 16
    track_genes_height   = 3       // height of the gene track
    track_log2_min       = -6      // fixed limits of log2ratio tracks (never grouped)
    track_log2_max       = 2
    // Peak QC tracks: regions chosen automatically from the peak sets (bin/peak_qc_regions.py) and drawn as track set peak_qc (results/tracks/peak_qc/)
    run_peak_qc          = true    // on whenever a peak caller (run_csaw, run_macs3, run_seacr) makes peaks; skipped silently when there is no peak set; the figures also need run_tracks
    peak_qc_loci         = ''      // your own loci, comma list of [NAME=]GENE|chr:s-e[:FLANK]; GENE may be a glob or A*|B alternatives (e.g. 'HOXA=HOXA*|HOTTIP|HOTAIRM1:150000,CDKN2A:125000'); '' = the default marker loci of Polycomb marks, none for other marks
    peak_qc_negative     = 'auto'  // negative-control locus: auto | none | GENE[:FLANK] | chr:s-e
    peak_qc_max_regions  = 15      // cap on the number of regions (your own loci are never dropped)
    peak_qc_exclude_bed  = null    // optional BED (or comma list) masked out of the peak-free high-signal tile search; set it to the general T2T blacklist to avoid satellite tiles
    peak_qc_nopeak_igg_max_fold = 1.5  // reject nopeak_highsignal tiles whose IgG fold exceeds this; null or '' = off; only used when the peak-QC bigWigs include an IgG
    peak_qc_shape_marks  = ''      // marks that get largest / median / densest regions (at most 3), comma list; '' = every mark (the first 3 when the run has more)
    run_annotation       = false   // peak annotation of the peak sets (csaw, MACS3 and SEACR labels)
    annotation_colors    = ''      // optional "label=#hex,label2=#hex" per peak-set label; empty = default colours
    annotation_extra_beds = ''     // comma list of extra regions annotated next to the peak sets: csaw peak set names, classification regions (<id>.retained ...), intersect names or BED paths; label = the name (file stem for a path)
    annotation_kegg      = true    // KEGG enrichment in the peak annotation
    annotation_tss_region = 3000   // bp each side of the TSS counted as promoter
    run_intersect        = false   // intersects CSV (intersects): overlap of two peak sets

    // ---- Replacing a step's script for one project ----------------------
    // Script replacements are not declared here (each config.yaml key is named after the script,
    // e.g. `norm_tmm: utils/norm_tmm.R`), but the `<name>_args` extras are, below. See
    // stepScripts() in main.nf. Scripts are task inputs, so -resume re-runs
    // only the step whose script changed (and what's downstream of it).
    // Extra arguments per step (config.yaml `<name>_args`). Declared (null) so the modules can reference params.<name>_args directly: Nextflow then hashes the value, and changing it re-runs exactly that step.
    align_args                       = null
    bam_filter_args                  = null
    bam_finalize_args                = null
    bam_prealigned_args              = null
    bigwig_args                      = null
    bigwig_log2ratio_args            = null
    bin_counts_args                  = null
    blacklist_filter_args            = null
    build_report_args                = null
    callpeaks_csaw_args              = null
    callpeaks_macs3_args             = null
    classify_regions_args            = null
    classify_regions_plot_args       = null
    csaw_cutoff_scan_args            = null
    dedup_split_args                 = null
    fastqc_args                      = null
    heatmap_build_matrix_args        = null
    heatmap_cluster_args             = null
    heatmap_computematrix_args       = null
    heatmap_limits_args              = null
    heatmap_plot_args                = null
    heatmap_plot_enriched_args       = null
    intersect_beds_args              = null
    library_complexity_frags_args    = null
    make_tracks_ini_args             = null
    markdup_args                     = null
    multiqc_args                     = null
    norm_chipseqspikeinfree_args     = null
    norm_combine_args                = null
    norm_cpm_args                    = null
    norm_qc_args                     = null
    norm_qc_plot_args                = null
    norm_spikein_args                = null
    norm_tmm_args                    = null
    peak_annotation_args             = null
    peak_qc_regions_args             = null
    picard_elc_args                  = null
    preseq_ccurve_args               = null
    qc_alignment_plot_args           = null
    qc_alignment_table_args          = null
    qc_correlation_args              = null
    qc_fingerprint_args              = null
    qc_fragment_sizes_plot_args      = null
    qc_fragment_sizes_table_args     = null
    qc_frip_args                     = null
    qc_frip_table_args               = null
    qc_library_complexity_plot_args  = null
    qc_library_complexity_table_args = null
    qc_peak_stats_args               = null
    qc_replicate_correlation_args    = null
    qc_replicate_correlation_plot_args = null
    qc_preseq_plot_args              = null
    qc_tss_enrichment_args           = null
    qc_tss_table_args                = null
    seacr_bedgraph_args              = null
    seacr_call_args                  = null
    seacr_consensus_args             = null
    tracks_limits_args               = null
    tracks_pygenometracks_args       = null
    trim_args                        = null

    help                 = false
}

// Base resources first: settings in the profiles below (e.g. test) must override them.
includeConfig 'conf/base.config'

// ---------------------------------------------------------------------------
// Profiles. There is no cluster profile in the Docker version: every run
// uses the local executor inside the container (conf/docker.config), which
// run_cutandrun selects with -profile docker. `test` only shrinks resource
// requests for smoke tests.
// ---------------------------------------------------------------------------
profiles {
    docker {
        includeConfig 'conf/docker.config'
    }
    test {
        includeConfig 'conf/test.config'
    }
}


// ---------------------------------------------------------------------------
// Execution provenance — every run records its own report/trace/DAG.
// Filenames are static (overwritten each run) rather than timestamped: a
// top-level `def` mixed with config blocks is rejected by newer Nextflow
// config parsers ("Variable declarations cannot be mixed with config
// statements"). Pass -with-report/-with-trace/-with-timeline/-with-dag with
// your own path on the command line if you want per-run, non-overwritten copies.
// ---------------------------------------------------------------------------
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.metadata_dir}/pipeline_info/execution_timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.metadata_dir}/pipeline_info/execution_report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.metadata_dir}/pipeline_info/execution_trace.txt"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.metadata_dir}/pipeline_info/pipeline_dag.html"
}

// Completion message — defined here (not in main.nf) because config files
// use plain assignment for this hook, sidestepping main.nf's strict script
// parser (which rejects a top-level `workflow.onComplete {}` statement, and
// a version nested inside `workflow {}` resolves `workflow` to null).
workflow.onComplete = {
    // `log` is not bound in config-file closure scope (only in the pipeline
    // script) — use println here, not log.info.
    def status = workflow.success ? 'completed successfully' : 'FAILED'
    println "\nPipeline ${status}. Results in: ${params.outdir}\n"
}
