/*
 * conf/base.config — per-process resources and retry policy, Docker version.
 *
 * Everything runs inside ONE container (the omics image, docker/image.txt)
 * with Nextflow's local executor. There is no cluster: the run gets one budget
 * of CPUs and memory for the whole computer (chosen and enforced by
 * run_cutandrun), and the requests below only decide how many steps run side
 * by side inside that budget. Every request is capped to the budget
 * (process.resourceLimits, conf/docker.config), so a request never blocks a
 * step on a small computer.
 *
 * The requests are the cluster version's (the same cpus and memory per step);
 * only the budget they are capped to is different.
 */

process {
    cpus          = 1
    memory        = 4.GB
    time          = '1.h'

    // Retry with escalating memory on OOM-kill (137 in Docker, 143 on a signal).
    // Exit 140 (the cluster's wall-time kill) stays in the list; the local
    // executor has no wall-time limit, so it does not occur here.
    // Also retry (without escalating memory) on any other exit code up to
    // twice, so a transient failure of the container (e.g. Docker Desktop
    // hiccup) does not fail the run.
    //
    // Exit code 3 is reserved for "known data problem, retrying can't help"
    // (e.g. a missing control, an empty BAM, a missing/NaN scale factor) — fail once with a clear message instead of retrying.
    errorStrategy = {
        task.exitStatus in [137, 140, 143] ? 'retry'
            : task.exitStatus == 3        ? 'finish'
            : (task.attempt <= 2 ? 'retry' : 'finish')
    }
    maxRetries    = 3

    // pipefail: without it, `tool ... | tee log` reports tee's exit status, so
    // a crashing tool looks like a success and only surfaces later as a
    // misleading "missing output file" (this is how a real MAGeCK
    // ZeroDivisionError was first hidden).
    shell = ['/bin/bash', '-euo', 'pipefail']

    // Every task's exact command is what a labmate or an agent needs to see
    // to troubleshoot or reproduce it — the legacy pipeline saved this as a
    // batch file next to each step's log; Nextflow's .command.sh is that
    // file already, just left inside its (ephemeral, hash-named) work dir.
    // afterScript runs after the main script/stub regardless of its exit
    // status, so this copy happens even for a step that fails, and .command.sh
    // is already fully interpolated (every ${...} resolved to what actually
    // ran, not the template). Each module then declares `command.sh` as an
    // output with its own publishDir, so it lands in that step's own
    // results/.../log/ next to the step's regular log — see any module for
    // the pattern. The fused BAM_PROCESS instead writes and publishes one command log per step (<sample>_<step>_command.sh), made by the task itself, not command.sh.
    afterScript = 'cp .command.sh command.sh 2>/dev/null || true'

    withName: 'FASTQC' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = '1.h'
    }
    withName: 'TRIM' {
        cpus   = 8
        memory = { 8.GB * task.attempt }
        time   = '4.h'
    }
    withName: 'ALIGN' {
        cpus   = 16
        memory = { 32.GB * task.attempt }
        time   = '8.h'
    }
    withName: 'BAM_FILTER' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = '4.h'
    }
    // BAM_PROCESS = fused MARKDUP + DEDUP_SPLIT + BLACKLIST_FILTER + BAM_FINALIZE: max cpus (2, 4, 2, 4), max memory (16, 16, 8, 16 GB), time 4 + 4 + 2 + 3 h.
    withName: 'BAM_PROCESS' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = '13.h'
    }
    withName: 'BAM_PREALIGNED' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = '1.h'
    }
    withName: 'QC_ALIGNMENT_TABLE' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = '30.min'
    }
    withName: 'QC_ALIGNMENT_PLOT' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = '30.min'
    }
    withName: 'QC_FRAGMENT_SIZES_TABLE' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = '2.h'
    }
    withName: 'QC_FRAGMENT_SIZES_PLOT' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = '30.min'
    }
    withName: 'LIBCOMPLEXITY_FRAGS' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = '2.h'
    }
    withName: 'PICARD_ELC' {
        cpus   = 2
        memory = { 16.GB * task.attempt }
        time   = '3.h'
    }
    withName: 'QC_LIBCOMPLEXITY_TABLE' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = '30.min'
    }
    withName: 'QC_LIBCOMPLEXITY_PLOT' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = '30.min'
    }
    withName: 'PRESEQ' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = '2.h'
    }
    withName: 'QC_PRESEQ_PLOT' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = '30.min'
    }
    withName: 'FINGERPRINT' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = '2.h'
    }
    withName: 'CORRELATION' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = '4.h'
    }
    withName: 'FRIP' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = '1.h'
    }
    withName: 'QC_FRIP_TABLE' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = '30.min'
    }
    withName: 'TSS_ENRICHMENT' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = '2.h'
    }
    withName: 'QC_TSS_TABLE' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = '30.min'
    }
    withName: 'QC_PEAK_STATS' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = '30.min'
    }
    withName: 'MULTIQC' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = '1.h'
    }
    withName: 'REPORT' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = '1.h'
    }
    withName: 'CHIPSEQSPIKEINFREE' {
        cpus   = 8
        memory = { 8.GB * task.attempt }
        time   = '12.h'
    }
    withName: 'SPIKEIN' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = '1.h'
    }
    withName: 'BIN_COUNTS' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = '4.h'
    }
    withName: 'TMM' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = '30.min'
    }
    withName: 'NORM_CPM|NORM_COMBINE' {
        cpus   = 1
        memory = 1.GB
        time   = '10.min'
    }
    withName: 'NORM_QC' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = '1.h'
    }
    withName: 'REPLICATE_CORRELATION' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = '1.h'
    }
    withName: 'REPLICATE_CORRELATION_PLOT' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = '30.min'
    }
    withName: 'BIGWIG' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = '4.h'
    }
    withName: 'BIGWIG_LOG2RATIO' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = '2.h'
    }
    withName: 'CSAW' {
        cpus   = 8
        memory = { 64.GB * task.attempt }
        time   = '12.h'
    }
    withName: 'CSAW_CUTOFF_SCAN' {
        cpus   = 8
        memory = { 64.GB * task.attempt }
        time   = '12.h'
    }
    withName: 'CLASSIFY_REGIONS' {
        cpus   = 4
        memory = { 32.GB * task.attempt }
        time   = '4.h'
    }
    withName: 'CLASSIFY_REGIONS_PLOT' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = '30.min'
    }
    withName: 'MACS3' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = '4.h'
    }
    withName: 'SEACR_BEDGRAPH' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = '2.h'
    }
    withName: 'SEACR_CALL' {
        cpus   = 2
        memory = { 16.GB * task.attempt }
        time   = '2.h'
    }
    withName: 'SEACR_CONSENSUS' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = '30.min'
    }
    withName: 'COMPUTEMATRIX|COMPUTEMATRIX_CLUSTERED' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = '2.h'
    }
    withName: 'HEATMAP_CLUSTER' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = '4.h'
    }
    withName: 'PLOTHEATMAP' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = '1.h'
    }
    withName: 'HEATMAP_LIMITS' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = '1.h'
    }
    withName: 'BUILD_MATRIX' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = '4.h'
    }
    withName: 'PLOT_ENRICHED' {
        cpus   = 1
        memory = { 16.GB * task.attempt }
        time   = '2.h'
    }
    withName: 'TRACKS_INI' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = '30.min'
    }
    withName: 'TRACKS_LIMITS' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = '30.min'
    }
    withName: 'PEAK_QC_REGIONS' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = '2.h'
    }
    withName: 'PYGENOMETRACKS' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = '1.h'
    }
    withName: 'PEAK_ANNOTATION' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = '4.h'
    }
    withName: 'INTERSECT' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = '30.min'
    }
    withName: 'NORM_QC_PLOT' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = '30.min'
    }
}
