# live elsewhere. Root-anchored so examples/config.yaml stays tracked.
/config.yaml
/original_data/
/metadata/
/intermediate_files/
/results/

# Container cache (large binary .sif files — shared at /project/rephilllab/nf_containers, not versioned)
*.sif
.singularity/
.apptainer/

# OS / editor
.DS_Store
*.swp
