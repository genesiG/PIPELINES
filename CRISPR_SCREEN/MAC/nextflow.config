/*
 * CRISPR_SCREEN — reproducible CRISPR screen pipeline, Docker version
 * (Windows / Mac personal computers). Same pipeline as the cluster version,
 * run inside one Docker image instead of LSF + Apptainer.
 *
 * Reusable across projects/labmates: nothing project-specific lives here.
 * Each project supplies its own config.yaml (see examples/config.yaml,
 * fetched via `run_crisprscreen init`) and runs with `run_crisprscreen`,
 * which starts the container and, inside it, runs
 *   nextflow run /pipeline -params-file config.yaml -resume
 * (docker/run_in_container.sh). Don't call nextflow yourself.
 *
 * Directory convention (shared across all lab pipelines, not just this one):
 *   samplesheet.csv, library.csv, contrasts.csv — your own small input CSVs,
 *                                  live at the project root (config.yaml too)
 *   raw FASTQs                  — wherever you keep them: config.yaml points to them, never moved or copied
 *   original_data/fastq/        — per-sample FASTQ(s): this pipeline's demultiplexing output,
 *                                  or the user's already-demultiplexed FASTQs
 *   metadata/                   — pipeline-generated run metadata: run logs (nf_logs/),
 *                                  Nextflow's execution report/trace/timeline/DAG,
 *                                  .nextflow.log, and failed_tasks/ (what a failed step ran and said)
 *   results/<step>/             — final outputs, one subfolder per pipeline step
 *     intermediate_files/       — under results/: tool-format conversions (e.g. the MAGeCK-format library)
 *   work/                       — Nextflow's working files (enables -resume). Deleted after a
 *                                  successful run unless keep_work: true; a failed or stopped
 *                                  run keeps it. `run_crisprscreen clean` deletes it at any time.
 */

manifest {
    name            = 'CRISPR_SCREEN'
    description     = 'Reproducible CRISPR screen pipeline (demultiplex -> count -> test), Docker version for Windows/Mac'
    author          = 'Rephill Lab'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.10.0'
    version         = '0.1.0'
}

// ---------------------------------------------------------------------------
// Default parameters — override per-project via -params-file config.yaml
// (do NOT edit these defaults for a specific project; use your own config.yaml)
// ---------------------------------------------------------------------------
params {
    // ---- Project identity ---------------------------------------------
    // Every output filename/prefix is derived from this. Set per project.
    project_name        = 'my_screen'

    // ---- Required inputs -------------------------------------------------
    samplesheet          = null   // CSV: barcode_id,barcode,sample_name (convention: project-root samplesheet.csv)
    library               = null   // CSV (or glob): gene,gRNA_ID,sequence (convention: project-root library.csv)
    // fastq_r1/fastq_r2: point these at wherever your raw multiplexed FASTQ(s)
    // currently sit on this computer. They stay where they are: never moved or
    // copied, and config.yaml is never rewritten.
    fastq_r1              = null   // multiplexed R1 (or single-end) fastq.gz
    fastq_r2              = null   // multiplexed R2 fastq.gz (paired-end only)
    // Already demultiplexed? Set fastq_dir (a directory of <sample_name>.fastq.gz,
    // or _R1/_R2 when paired): demultiplexing is skipped and fastq_r1/fastq_r2
    // are ignored. The directory stays where it is and its FASTQs are read in place.
    fastq_dir             = null

    // ---- This computer's resources (Docker version only) ------------------
    // null = the default budget (what the pipeline can use, docker/requirements.conf
    // max_useful_memory_gb, but at most 75% of the computer's memory, leaving at
    // least 3 GB to the system; all CPU cores but 1-2; never more than Docker
    // Desktop allows). Read by run_crisprscreen, which enforces the budget as
    // the container's limits; conf/docker.config hands it to the scheduler.
    max_cpus              = null
    max_memory_gb         = null

    // ---- Run mode ----------------------------------------------------
    paired_end            = false

    // ---- Demultiplexing / counting parameters --------------------------
    sgrna_len              = 20
    // Leave trim5 null (default): the pipeline finds each library's own
    // constant vector sequence automatically (GUIDE_ANCHOR_DISCOVERY, no
    // prior knowledge of its sequence or length needed) and positions every
    // read's guide from it (GUIDE_ANCHOR_TRIM) — robust to any plasmid
    // design, nothing to tune per project. Set trim5 to a number only to
    // bypass this and use a fixed 5' trim length instead (e.g. to
    // reproduce a specific prior run byte-for-byte).
    trim5                  = null

    // ---- Step 3: statistical testing (optional) -------------------------
    // Leave null to stop the pipeline after counting + QC (e.g. pilot/QC-only libraries).
    contrasts               = null  // CSV: treatment,control  (patterns matched against count-table sample columns)

    // ---- Output / directory convention -------------------------------
    // See the directory-convention comment at the top of this file.
    original_data_dir        = './original_data'
    metadata_dir               = './metadata'
    intermediate_dir          = './results/intermediate_files'
    outdir                     = './results'

    publish_mode                = 'copy'   // 'copy' (safe default) or 'symlink' (saves space, same filesystem only)
    // false = delete work/ after a successful run to free disk space (the next run then recomputes
    // every step); true = keep work/ for -resume. Failed or stopped runs always keep it. Deleting it
    // is only safe because publish_mode is 'copy': results/ must never point into work/, so do not
    // use 'symlink' with keep_work = false.
    keep_work                   = false

    // ---- Replacing a step's script for one project ----------------------
    // Not declared here on purpose. Every step runs a script from bin/; a
    // project's config.yaml replaces one with a key named after the script
    // (file name without extension), e.g. `mageck_count: utils/mageck_count.sh`,
    // plus optional `<name>_args: "..."` for extra arguments. See
    // stepScripts() in main.nf. Scripts are task inputs, so -resume re-runs
    // only the step whose script changed (and what's downstream of it).

    help                     = false
}

// ---------------------------------------------------------------------------
// Profiles. There is no cluster profile in the Docker version: every run
// uses the local executor inside the container (conf/docker.config).
// `test` only shrinks resource requests for smoke tests.
// ---------------------------------------------------------------------------
profiles {
    test {
        includeConfig 'conf/test.config'
    }
}

includeConfig 'conf/base.config'
includeConfig 'conf/docker.config'

// ---------------------------------------------------------------------------
// Execution provenance — every run records its own report/trace/DAG.
// Filenames are static (overwritten each run) rather than timestamped: a
// top-level `def` mixed with config blocks is rejected by newer Nextflow
// config parsers ("Variable declarations cannot be mixed with config
// statements"). Pass -with-report/-with-trace/-with-timeline/-with-dag with
// your own path on the command line if you want per-run, non-overwritten copies.
// ---------------------------------------------------------------------------
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.metadata_dir}/pipeline_info/execution_timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.metadata_dir}/pipeline_info/execution_report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.metadata_dir}/pipeline_info/execution_trace.txt"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.metadata_dir}/pipeline_info/pipeline_dag.html"
}

// Completion message — defined here (not in main.nf) because config files
// use plain assignment for this hook, sidestepping main.nf's strict script
// parser (which rejects a top-level `workflow.onComplete {}` statement, and
// a version nested inside `workflow {}` resolves `workflow` to null).
workflow.onComplete = {
    // `log` is not bound in config-file closure scope (only in the pipeline
    // script) — use println here, not log.info.
    def status = workflow.success ? 'completed successfully' : 'FAILED'
    println "\nPipeline ${status}. Results in: ${params.outdir}\n"
    // METHODS (modules/local/methods.nf) runs last, so only a successful run rewrites METHODS.md.
    println workflow.success
        ? "Materials and methods for this run: METHODS.md (also in ${params.outdir}/)\n"
        : "METHODS.md was not updated: it still describes the last successful run (named at its top), if any.\n"
}
