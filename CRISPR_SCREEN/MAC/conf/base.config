/*
 * conf/base.config — per-process resources and retry policy, Docker version.
 *
 * Everything runs inside ONE container (docker/Dockerfile) with Nextflow's
 * local executor. There is no cluster: the run gets one budget of CPUs and
 * memory for the whole computer (chosen and enforced by run_crisprscreen —
 * see "Resources" in README.md), and the requests below only decide how many
 * steps run side by side inside that budget. Every request is capped to the
 * budget (process.resourceLimits, conf/docker.config), so a request never
 * blocks a step on a small computer.
 *
 * Memory requests are each step's measured peak on the cluster, with
 * headroom: 4 real runs, 151 tasks, incl. two full-lane demultiplexings
 * (traces collected 2026-10-15). Every step peaked below 0.9 GB:
 *   FASTQC 0.88  GUIDE_REPRESENTATION_WRANGLE 0.72  COMPARE_REPORT 0.45
 *   DEMULTIPLEX 0.37  MAGECK_COUNT 0.37  GUIDE_ANCHOR_TRIM 0.30  PLOT 0.25
 *   MULTIQC 0.20  REPORT 0.19  SOFTWARE_VERSIONS 0.13  PLOT_BARCODE_POSITION 0.10
 *   GUIDE_ANCHOR_DISCOVERY 0.07  others < 0.02 GB
 * CPU requests are what each tool actually keeps busy (CPU time / wall time
 * on the cluster): cutadapt ~5 cores, everything else 1.
 *
 * The local executor does not police memory; the container's hard limit
 * does. A step that outgrows its request on unusually large data is killed
 * with exit 137 and retried with twice, then three times the request, which
 * lets fewer steps run beside it.
 */

process {
    cpus          = 1
    memory        = 1.GB
    // No wall-time limit on a personal computer: a laptop (or an Apple
    // Silicon Mac emulating amd64) can be several times slower than the
    // cluster, and a step killed for time would just have to start over.
    time          = 30.d

    // Retry with escalating memory on OOM-kill (137/143). Also retry
    // (without escalating memory) on any other exit code up to twice.
    //
    // Exit code 3 is reserved for "known data problem, retrying can't help"
    // (e.g. MAGECK_COUNT given a sample with zero reads mapping to the
    // library) — fail once with a clear message instead of retrying.
    errorStrategy = {
        task.exitStatus in [137, 140, 143] ? 'retry'
            : task.exitStatus == 3        ? 'finish'
            : (task.attempt <= 2 ? 'retry' : 'finish')
    }
    maxRetries    = 3

    // pipefail: without it, `tool ... | tee log` reports tee's exit status, so
    // a crashing tool looks like a success and only surfaces later as a
    // misleading "missing output file" (this is how a real MAGeCK
    // ZeroDivisionError was first hidden).
    shell = ['/bin/bash', '-euo', 'pipefail']

    // Every task's exact command is published as <name>_command.sh next to
    // the step's log (see any module): afterScript copies Nextflow's own
    // .command.sh (fully interpolated) out of the hidden work directory, even
    // for a step that fails.
    afterScript = 'cp .command.sh command.sh 2>/dev/null || true'

    withName: 'DEMULTIPLEX_.*|GUIDE_ANCHOR_TRIM' {
        // cutadapt --cores 0 uses every core of the run's budget (the
        // container only sees those cores): reserve them all, so the
        // scheduler's picture matches what really runs. These are the long
        // steps, and the steps after them wait for them anyway.
        cpus   = { (System.getenv('CRISPR_MAX_CPUS') ?: '2') as int }
        memory = { 1.GB * task.attempt }
    }
    withName: 'FASTQC' {
        // One FASTQ per task: FastQC's --threads only parallelizes across
        // files, so a second core would sit idle (measured: 1.15 cores busy).
        memory = { 2.GB * task.attempt }
    }
    withName: 'GUIDE_REPRESENTATION_WRANGLE|MAGECK_COUNT' {
        // Data-dependent (every distinct unmapped sequence is held/read):
        // the most headroom over the measured peak.
        memory = { 2.GB * task.attempt }
    }
    withName: 'GUIDE_REPRESENTATION_PLOT|GUIDE_REPRESENTATION_REPORT|GUIDE_REPRESENTATION_COMPARE_REPORT|PLOT_BARCODE_POSITION|MULTIQC|MAGECK_TEST' {
        memory = { 1.GB * task.attempt }
    }
    withName: 'CUTADAPT_STATS|BUILD_MAGECK_LIBRARY|GUIDE_ANCHOR_DISCOVERY|VALIDATE_CONTRASTS|LIBRARY_BREAKDOWN|SOFTWARE_VERSIONS|METHODS' {
        memory = { 512.MB * task.attempt }
    }
}
