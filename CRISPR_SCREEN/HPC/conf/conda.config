/*
 * conf/conda.config — fallback execution using conda/mamba environments
 * instead of containers. Use this profile only where no container path is
 * available yet (e.g. Phase 3: CRISPRO / PyMOL, which are not on any public
 * container registry). Combine with -profile pmacs,conda to keep LSF
 * scheduling while swapping Apptainer for conda per-process.
 *
 * Requires: `conda env create -f environment.yml` already run once
 * (see repo root README for the environment name each process expects).
 */

conda {
    enabled = true
    useMamba = true
}

process {
    withName: 'MAGECK_COUNT|MAGECK_TEST|BUILD_MAGECK_LIBRARY' {
        conda = 'bioconda::mageck=0.5.9.5'
    }
    withName: 'DEMULTIPLEX_.*|GUIDE_ANCHOR_DISCOVERY|GUIDE_ANCHOR_TRIM' {
        conda = 'bioconda::cutadapt=5.2'
    }
    withName: 'FASTQC' {
        conda = 'bioconda::fastqc=0.12.1'
    }
    withName: 'MULTIQC' {
        conda = 'bioconda::multiqc=1.34'
    }
    withName: 'GUIDE_REPRESENTATION_.*|PLOT_BARCODE_POSITION' {
        conda = 'conda-forge::r-base=4.3 conda-forge::r-dplyr conda-forge::r-tidyr conda-forge::r-ggplot2'
    }
}
