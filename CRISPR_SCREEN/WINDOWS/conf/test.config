/*
 * conf/test.config — reduced resource footprint for smoke-testing the
 * pipeline against a tiny synthetic dataset (developers only; run inside the
 * container with -profile test). Still requires your own -params-file
 * pointing at (small) real input files.
 */
process {
    withName: 'DEMULTIPLEX_.*' { cpus = 1; memory = 2.GB; time = '15.min' }
    withName: 'FASTQC'          { cpus = 1; memory = 1.GB; time = '10.min' }
    withName: 'MULTIQC'          { cpus = 1; memory = 1.GB; time = '10.min' }
    withName: 'CUTADAPT_STATS'    { cpus = 1; memory = 1.GB; time = '10.min' }
    withName: 'BUILD_MAGECK_LIBRARY' { cpus = 1; memory = 1.GB; time = '10.min' }
    withName: 'GUIDE_ANCHOR_DISCOVERY' { cpus = 1; memory = 1.GB; time = '10.min' }
    withName: 'GUIDE_ANCHOR_TRIM'      { cpus = 1; memory = 2.GB; time = '15.min' }
    withName: 'MAGECK_COUNT'       { cpus = 1; memory = 2.GB; time = '15.min' }
    withName: 'GUIDE_REPRESENTATION_.*' { cpus = 1; memory = 2.GB; time = '15.min' }
    withName: 'VALIDATE_CONTRASTS'    { cpus = 1; memory = 1.GB; time = '10.min' }
    withName: 'MAGECK_TEST'            { cpus = 1; memory = 1.GB; time = '10.min' }
    withName: 'SOFTWARE_VERSIONS|METHODS' { cpus = 1; memory = 1.GB; time = '10.min' }
}
