/*
 * conf/docker.config — running on a personal computer (Windows or Mac),
 * inside the pipeline's Docker image (docker/image.txt). Replaces the cluster
 * version's profile (conf/pmacs.config in the HPC copy: LSF + Apptainer).
 *
 * Nextflow itself runs inside the container that run_atacseq starts, and
 * every step runs right there with the local executor: all tools (Trimmomatic,
 * Bowtie2, samtools, sambamba, bedtools, bedops, deepTools, MACS3, FastQC,
 * MultiQC, R and Python) are installed in that one image, so Nextflow does not
 * start containers of its own (// FastQC reads its FASTQ in small pieces. Through Docker's link to the host's files (the FASTQs are mounted from
// the Windows or Mac drive) that is latency-bound: measured on atac_av_6349 (3 GB FASTQs on C:), FASTQC_RAW took 21-29
// min per file at 26% cpu, and 1h13-1h30 per file with the FASTQs on the busy D: hard disk. One large sequential
// copy of the input into a scratch folder on Docker's own disk (about 60 MB/s) first lets FastQC run at full speed.
// base.config's afterScript copies .command.sh to command.sh (a declared output), but with scratch it runs after the
// outputs are copied back, in the scratch folder, so command.sh would be missing: copy it at the start instead,
// into the scratch folder when there is one (beforeScript runs in the work folder, before the move to scratch).
process {
    beforeScript = 'cp .command.sh "${NXF_SCRATCH:-.}/command.sh" 2>/dev/null || true'
    withName: 'FASTQC_RAW' {
        scratch     = '/tmp'
        stageInMode = 'copy'
    }
}

docker.enabled = false — no Docker-in-Docker needed).
 *
 * How parallel steps are handled: on the cluster every task (each library's
 * alignment, each library's peak calling, ...) was its own job on its own node.
 * Here they all share one pool — the run's budget — and the local executor starts
 * a task only when its cpus/memory requests (conf/base.config, conf/docker_tiers.config)
 * still fit next to the ones already running; the rest wait their turn. Results are
 * the same; only the order and the speed differ.
 *
 * The budget: run_atacseq picks it from the computer's hardware (default:
 * 75% of its memory, always leaving 3 GB to the system, and all cores but one
 * or two; config.yaml's max_cpus / max_memory_gb override it), enforces it as
 * the container's hard limits (docker run --memory, --cpuset-cpus), and hands
 * it to Nextflow below as ATAC_MAX_CPUS / ATAC_MAX_MEMORY_MB (minus what
 * Nextflow itself needs).
 */

executor {
    name      = 'local'
    cpus      = (System.getenv('ATAC_MAX_CPUS') ?: '2') as int
    memory    = "${System.getenv('ATAC_MAX_MEMORY_MB') ?: '2048'} MB"
}

process {
    executor       = 'local'
    // A request bigger than the budget is lowered to the budget instead of
    // never being scheduled.
    resourceLimits = [
        cpus:   (System.getenv('ATAC_MAX_CPUS') ?: '2') as int,
        memory: "${System.getenv('ATAC_MAX_MEMORY_MB') ?: '2048'} MB",
        time:   30.d
    ]
}

docker.enabled    = false
apptainer.enabled = false

// Environment variables for the steps' commands. ATAC_SORT_MEM is the memory per thread of samtools sort
// (-m in bin/bam_filter.sh, bin/bam_finalize.sh and bin/blacklist_filter.sh; the scripts default to the
// cluster's 1G). With -@ 4 the sort holds about 1 GB in all.
env {
    ATAC_SORT_MEM = '256M'
}

// Cpus, memory and the disk-heavy steps' concurrency per step. After base.config
// (which it overrides) and before conf/test.config in -profile docker,test.
includeConfig 'docker_tiers.config'
