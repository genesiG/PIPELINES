/*
 * conf/docker_tiers.config — cpus and memory per step on a personal computer.
 * Loaded by conf/docker.config: after conf/base.config (the cluster values, which
 * it overrides) and before conf/test.config (test still wins with -profile docker,test).
 *
 * Memory requests: the peak memory of each step measured on the cluster (cluster benchmark
 * traces atac_av_sub, am_sub, av_6349, 2026-10-29; not re-measured locally), times 1.25, rounded
 * up to the next 0.5 GB, at least 1 GB. Exceptions, set by hand and commented where they are set:
 * FASTQC (1 GB), TSS_ENRICHMENT (1.5 GB), ALIGN (fixed 5.0 GB, no retry escalation) and BAM_FILTER
 * and BAM_FINALIZE (2 GB: measured locally 1.3 and 1.2 GB with ATAC_SORT_MEM=256M, atac_av_6349). TN5_SHIFT is not measured (off in both datasets) and keeps base.config's values.
 *
 * There are no memory tiers in this version: no entry depends on the computer's memory,
 * so the requests are the same on every computer. The budget (ATAC_MAX_CPUS,
 * ATAC_MAX_MEMORY_MB, see docker/run_in_container.sh) only caps the requests
 * (process.resourceLimits, conf/docker.config), so a request never blocks a step; the
 * one cpus value that follows the budget is ALIGN's.
 *
 * cpus are the cluster's, but at most 4 for steps that work on one sample, so several
 * samples run at once. Exceptions: ALIGN (the budget's cpus less 2, at least 2) and
 * FASTQC (1: each task reads one file).
 *
 * Disk-heavy steps (FASTQC, TRIM, BAM_FILTER, DEDUP, BLACKLIST_FILTER, BIGWIG, BAM_FINALIZE): the
 * launcher exports ATAC_HDD=1 when a disk the run uses is a hard disk (HDD): the project folder's
 * drive, the drives of the FASTQ files, and Docker's disk when the work folder is the Docker volume.
 * Otherwise it exports 0 (an unknown disk counts as 0; the Mac launcher always exports 0). With 1
 * these steps run at most 2 at a time (maxForks 2): a hard disk may thrash, and two big sequential
 * BAM streams at once is what it copes with. With 0 there is no cap (maxForks 0 = unlimited),
 * because memory is the limit. This replaces the old rule on ATAC_WORK_VOLUME, which only looked at
 * where the work folder is; ATAC_WORK_VOLUME still sets that (docker/run_in_container.sh).
 *
 * With ATAC_HDD=1, FASTQC also runs at most 2 tasks at a time, so cpus and disk stay free for TRIM and ALIGN.
 */

process {
    // one withName per process name (base.config has the same keys, so these replace its values)
    withName: 'FASTQC_RAW|FASTQC_TRIM' {
        // measured peak ~0.8 GB (cluster benchmark traces 2026-10-29); x1.25 = 1.0 GB; set by hand to 1 GB
        cpus     = 1
        maxForks = (System.getenv('ATAC_HDD') == '1') ? 2 : 0   // disk: 2 at a time on a hard disk, see header
        memory   = { 1.GB * task.attempt }
    }
    withName: 'TRIM' {
        // measured peak 1.2 GB (cluster benchmark traces 2026-10-29) x1.25 = 1.5 GB, rounded to 2 GB
        cpus     = 2   // measured atac_av_6349 (full depth): trimmomatic -threads 4 used 0.9 cpu (gzip-bound), so 2 are enough and leave cpus for ALIGN
        maxForks = (System.getenv('ATAC_HDD') == '1') ? 2 : 0   // disk-heavy: 2 at a time on a hard disk, see header
        memory   = { 2.GB * task.attempt }
    }
    withName: 'ALIGN' {
        // bowtie2 threads (bin/align.sh -p) = the budget's cpus less 2 (at least 2), so FASTQC and
        // other small steps can run beside an alignment.
        // measured peak 3.9 GB = the bowtie2 T2T index, which each chunk loads (ALIGN is chunked): cluster benchmark traces 2026-10-29
        // (not re-measured locally). x1.25 = 5.0 GB. Fixed at 5.0 GB, no retry escalation
        cpus   = { Math.max(((System.getenv('ATAC_MAX_CPUS') ?: '2') as int) - 2, 2) }
        memory = 5.GB
    }
    withName: 'BAM_FILTER' {
        // measured atac_av_6349 (full depth, Docker, ATAC_SORT_MEM=256M) peak 1.3 GB, x1.25 = 1.6 GB, rounded to 2 GB (cluster peak was 4.7 GB with sort -m 1G -@ 4)
        cpus     = 4
        memory   = { 2.GB * task.attempt }
        maxForks = (System.getenv('ATAC_HDD') == '1') ? 2 : 0   // disk-heavy: 2 at a time on a hard disk, see header
    }
    withName: 'DEDUP' {
        // measured peak 2.2 GB (cluster benchmark traces 2026-10-29) x1.25 = 2.6 GB, rounded to 3 GB
        cpus     = 4
        maxForks = (System.getenv('ATAC_HDD') == '1') ? 2 : 0   // disk-heavy: 2 at a time on a hard disk, see header
        memory   = { 3.GB * task.attempt }
    }
    withName: 'BLACKLIST_FILTER' {
        // measured peak 1.2 GB (cluster benchmark traces 2026-10-29) x1.25 = 1.5 GB, rounded to 2 GB; its sort -n runs with ATAC_SORT_MEM
        cpus     = 2
        maxForks = (System.getenv('ATAC_HDD') == '1') ? 2 : 0   // disk-heavy: 2 at a time on a hard disk, see header
        memory   = { 2.GB * task.attempt }
    }
    withName: 'BAM_FINALIZE' {
        // measured atac_av_6349 (full depth, Docker, ATAC_SORT_MEM=256M) peak 1.2 GB, x1.25 = 1.5 GB, rounded to 2 GB (cluster peak was 4.7 GB with sort -m 1G -@ 4)
        cpus     = 4
        maxForks = (System.getenv('ATAC_HDD') == '1') ? 2 : 0   // disk-heavy: 2 at a time on a hard disk, see header
        memory   = { 2.GB * task.attempt }
    }
    // TN5_SHIFT is not measured (off in both datasets): it keeps base.config's values.
    withName: 'QC_CHROM_FRACTION' {
        // measured peak below 250 MB (cluster benchmark traces 2026-10-29) x1.25; floor 1 GB
        cpus   = 1
        memory = { 1.GB * task.attempt }
    }
    withName: 'CONTAMINATION' {
        // measured peak 3.3 GB (cluster benchmark traces 2026-10-29) x1.25 = 4.1 GB, rounded to 4.5 GB
        cpus   = 4
        memory = { 4.5.GB * task.attempt }
    }
    withName: 'QC_FRAGMENT_SIZES_TABLE' {
        // measured peak 431 MB (cluster benchmark traces 2026-10-29) x1.25; floor 1 GB
        cpus   = 4
        memory = { 1.GB * task.attempt }
    }
    withName: 'QC_FRAGMENT_SIZES_PLOT' {
        // measured peak below 250 MB (cluster benchmark traces 2026-10-29) x1.25; floor 1 GB
        cpus   = 1
        memory = { 1.GB * task.attempt }
    }
    withName: 'TSS_ENRICHMENT' {
        // measured peak 812 MB (cluster benchmark traces 2026-10-29) x1.25 = 1.0 GB; set by hand to 1.5 GB
        // measured atac_av_6349 and atac_av_sub (Docker): computeMatrix --numberOfProcessors uses only about 1.2 cpus (122% cpu,
        // 7 min per library), so 4 cpus held 3 of the 6 cpus idle and ran the nine libraries one after the other (62 min in all
        // on atac_av_sub). 2 cpus let three run side by side.
        cpus   = 2
        memory = { 1.5.GB * task.attempt }
    }
    withName: 'QC_TSS_TABLE' {
        // measured peak below 250 MB (cluster benchmark traces 2026-10-29) x1.25; floor 1 GB
        cpus   = 1
        memory = { 1.GB * task.attempt }
    }
    withName: 'FRIP' {
        // measured peak below 250 MB (cluster benchmark traces 2026-10-29) x1.25; floor 1 GB
        cpus   = 1
        memory = { 1.GB * task.attempt }
    }
    withName: 'QC_FRIP_TABLE' {
        // measured peak below 250 MB (cluster benchmark traces 2026-10-29) x1.25; floor 1 GB
        cpus   = 1
        memory = { 1.GB * task.attempt }
    }
    withName: 'QC_PEAK_STATS' {
        // measured peak below 250 MB (cluster benchmark traces 2026-10-29) x1.25; floor 1 GB
        cpus   = 1
        memory = { 1.GB * task.attempt }
    }
    withName: 'MULTIQC' {
        // measured peak below 250 MB (cluster benchmark traces 2026-10-29) x1.25; floor 1 GB
        cpus   = 1
        memory = { 1.GB * task.attempt }
    }
    withName: 'COUNT_PAIRS' {
        // measured peak below 250 MB (cluster benchmark traces 2026-10-29) x1.25; floor 1 GB
        cpus   = 1
        memory = { 1.GB * task.attempt }
    }
    withName: 'ALIGN_MERGE' {
        // measured peak below 250 MB (cluster benchmark traces 2026-10-29) x1.25; floor 1 GB
        cpus   = 1
        memory = { 1.GB * task.attempt }
    }
    withName: 'ALIGNMENT_SUMMARY' {
        // measured peak below 250 MB (cluster benchmark traces 2026-10-29) x1.25; floor 1 GB
        cpus   = 1
        memory = { 1.GB * task.attempt }
    }
    withName: 'NORM_TMM' {
        // measured peak 949 MB (cluster benchmark traces 2026-10-29) x1.25 = 1.2 GB, rounded to 1.5 GB
        cpus   = 4
        memory = { 1.5.GB * task.attempt }
    }
    withName: 'BIGWIG' {
        // measured peak 948 MB (cluster benchmark traces 2026-10-29) x1.25 = 1.2 GB, rounded to 1.5 GB
        cpus     = 4
        maxForks = (System.getenv('ATAC_HDD') == '1') ? 2 : 0   // disk-heavy: 2 at a time on a hard disk, see header
        memory   = { 1.5.GB * task.attempt }
    }
    withName: 'MACS3' {
        // measured peak 1.2 GB (cluster benchmark traces 2026-10-29) x1.25 = 1.5 GB, rounded to 2 GB
        cpus   = 4
        memory = { 2.GB * task.attempt }
    }
    withName: 'PEAK_MERGE' {
        // measured peak below 250 MB (cluster benchmark traces 2026-10-29) x1.25; floor 1 GB
        cpus   = 1
        memory = { 1.GB * task.attempt }
    }
}
