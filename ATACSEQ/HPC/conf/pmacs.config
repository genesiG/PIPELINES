/*
 * conf/pmacs.config — UPenn PMACS (LSF) execution profile.
 *
 * Verified on the PMACS cluster (LSF + Apptainer), 2026-09-22.
 *
 * IMPORTANT — FIPS mode:
 *   PMACS compute nodes run OpenSSL in FIPS mode (/proc/sys/crypto/fips_enabled=1).
 *   Apptainer's Go runtime panics on ANY `apptainer exec` unless the host's
 *   OpenSSL FIPS provider module is bound into the container:
 *       panic: opensslcrypto: can't enable FIPS mode for OpenSSL ...
 *   The `-B /usr/lib64/ossl-modules` bind below fixes this for every
 *   container image, regardless of the image's own OS/OpenSSL version — do
 *   not remove it. GOLANG_FIPS=0 / GODEBUG=fips140=off / --userns / --fakeroot
 *   were all tested and do NOT fix this; only the bind mount does.
 */

process {
    executor = 'lsf'
    queue    = 'rhel9'
    // config.yaml lsf_exclude_hosts (comma list) -> bsub -R "select[hname!='a' && hname!='b']".
    // For a node where every container start fails (2026-10-27: one node, "FIPS mode is enabled, but the
    // required OpenSSL backend is unavailable"); such a node fails jobs in seconds and so keeps receiving them.
    clusterOptions = {
        def hosts = (params.lsf_exclude_hosts ?: '').toString().tokenize(', ').findAll { it }
        hosts ? '-R "select[' + hosts.collect { "hname!='${it}'" }.join(' && ') + ']"' : ''
    }
}

executor {
    name            = 'lsf'
    perJobMemLimit  = true   // the cluster's LSF configuration sets LSB_JOB_MEMLIMIT=Y: -M is a per-job
                              // (not per-slot) cap. Nextflow must know this or multi-core
                              // tasks will request N x the intended memory and queue forever.
    queueSize        = 50
    submitRateLimit   = '10/1min'
}

apptainer {
    enabled     = true
    autoMounts  = true
    cacheDir    = '/project/rephilllab/nf_containers'   // shared across the whole lab — pulled once, reused by everyone
    runOptions  = '-B /usr/lib64/ossl-modules'
}

// NOTE: workDir is intentionally NOT set here. run_pipeline.sh exports
// NXF_WORK to a per-user, per-project subfolder under
// /project/rephilllab/nf_work/ so runs from different labmates/projects
// never collide, while still keeping intermediate files off /home
// (which is already heavily used) and off node-local /tmp (which would
// break -resume across LSF-scheduled nodes).
