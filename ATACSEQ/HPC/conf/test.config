/*
 * conf/test.config — reduced resource footprint for smoke-testing the
 * pipeline (e.g. against a tiny synthetic dataset) without waiting on
 * full-size LSF allocations. Combine with -profile pmacs,test or
 * -profile local,test; still requires your own -params-file pointing at
 * (small) real input files.
 */

process {
    withName: 'FASTQC_RAW|FASTQC_TRIM|TRIM|ALIGNMENT_SUMMARY|BAM_FILTER|DEDUP|BLACKLIST_FILTER|BAM_FINALIZE|TN5_SHIFT|QC_CHROM_FRACTION|QC_FRAGMENT_SIZES_TABLE|QC_FRAGMENT_SIZES_PLOT|TSS_ENRICHMENT|QC_TSS_TABLE|FRIP|QC_FRIP_TABLE|QC_PEAK_STATS|MULTIQC|PEAK_MERGE|COUNT_PAIRS|ALIGN_MERGE' { cpus = 1; memory = 1.GB; time = '10.min' }
    withName: 'ALIGN|NORM_TMM|BIGWIG|MACS3|CONTAMINATION' { cpus = 1; memory = 2.GB; time = '15.min' }
    withName: 'BAM_PREALIGNED|TXDB_BUILD|DIFF_ACCESS|DIFF_ANNOTATE|MOTIF_ENRICHMENT|MOTIF_COMMON' { cpus = 1; memory = 1.GB; time = '10.min' }
}
