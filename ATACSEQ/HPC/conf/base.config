/*
 * conf/base.config — default per-process resources and retry policy.
 * Portable across executors (LSF via conf/pmacs.config, or -profile local for testing).
 */

process {
    cpus          = 1
    memory        = 4.GB
    time          = { 1.h * task.attempt }

    // Retry with escalating memory and wall time (both x attempt) on OOM-kill (LSF 137/143) or wall-time
    // kill (140). Wall times are sized for full-depth libraries: legacy AV bowtie2 (-p 16 -N 1 --local, one task
    // per library; alignment is now chunked) took 3-23 h per library (23 h for 211 M pairs); the 1M-pair test ran ~5 min per million pairs.
    // Also retry (without escalating memory) on any other exit code up to
    // twice — PMACS compute nodes occasionally hit a transient Apptainer
    // container-startup failure (observed: a FIPS/OpenSSL init panic that
    // did not reproduce on retry, on a node where the identical container
    // + bind mount had just succeeded moments before for a different task).
    //
    // Exit code 3 is reserved for "known data problem, retrying can't help"
    // (e.g. a missing control, an empty BAM, a missing/NaN scale factor) — fail once with a clear message instead of retrying.
    errorStrategy = {
        task.exitStatus in [137, 140, 143] ? 'retry'
            : task.exitStatus == 3        ? 'finish'
            : (task.attempt <= 2 ? 'retry' : 'finish')
    }
    maxRetries    = 3

    // pipefail: without it, `tool ... | tee log` reports tee's exit status, so
    // a crashing tool looks like a success and only surfaces later as a
    // misleading "missing output file" (this is how a real MAGeCK
    // ZeroDivisionError was first hidden).
    shell = ['/bin/bash', '-euo', 'pipefail']

    // Every task's exact command is what a labmate or an agent needs to see
    // to troubleshoot or reproduce it — the legacy pipeline saved this as a
    // batch file next to each step's log; Nextflow's .command.sh is that
    // file already, just left inside its (ephemeral, hash-named) work dir.
    // afterScript runs after the main script/stub regardless of its exit
    // status, so this copy happens even for a step that fails, and .command.sh
    // is already fully interpolated (every ${...} resolved to what actually
    // ran, not the template). Each module then declares `command.sh` as an
    // output with its own publishDir, so it lands in that step's own
    // results/.../log/ next to the step's regular log — see any module for
    // the pattern.
    afterScript = 'cp .command.sh command.sh 2>/dev/null || true'

    // Memory (2026-10-29): about 1.3-2x the largest peak RSS measured in the full-depth AV (30 libraries, up to
    // 211 M pairs) and AM runs, at least 1 GB; requests were 3-30x the peaks. Every retry multiplies the request by
    // the attempt number, so a larger library that exceeds it reruns with 2x, then 3x. TN5_SHIFT (off in both
    // datasets) is unmeasured. Measured peaks: ALIGN 4.6 GB, BAM_FILTER 5.0, BAM_FINALIZE 14.3 (BusyBox sort of the
    // orphan check, now samtools collate; samtools sort 4 x 1 GB), MACS3 3.6, CONTAMINATION 3.3, DEDUP 2.4, BIGWIG 1.6,
    // TRIM 1.2, BLACKLIST_FILTER 1.2, NORM_TMM 1.1, FASTQC 0.9, TSS_ENRICHMENT 0.8, the rest below 0.5.
    withName: 'FASTQC_RAW|FASTQC_TRIM' {
        cpus   = 2
        memory = { 2.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withName: 'TRIM' {
        cpus   = 8
        memory = { 2.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    // ALIGN: chunked (align_chunk_pairs > 0) a chunk gets 4 h; unchunked, a whole library gets 48 h.
    withName: 'ALIGN' {
        cpus   = 8
        memory = { 6.GB * task.attempt }
        time   = { ((params.align_chunk_pairs?.toString()?.trim() ==~ /[1-9][0-9]*/) ? 4.h : 48.h) * task.attempt }
    }
    withName: 'COUNT_PAIRS' {
        cpus   = 1
        memory = { 1.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withName: 'ALIGN_MERGE' {
        cpus   = 1
        memory = { 1.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withName: 'ALIGNMENT_SUMMARY' {
        cpus   = 1
        memory = { 1.GB * task.attempt }
        time   = { 10.min * task.attempt }
    }
    withName: 'BAM_FILTER' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withName: 'DEDUP' {
        cpus   = 4
        memory = { 4.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withName: 'BLACKLIST_FILTER' {
        cpus   = 2
        memory = { 2.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withName: 'BAM_FINALIZE' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    withName: 'TN5_SHIFT' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withName: 'QC_CHROM_FRACTION' {
        cpus   = 1
        memory = { 1.GB * task.attempt }
        time   = { 10.min * task.attempt }
    }
    withName: 'CONTAMINATION' {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withName: 'QC_FRAGMENT_SIZES_TABLE' {
        cpus   = 4
        memory = { 2.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withName: 'QC_FRAGMENT_SIZES_PLOT' {
        cpus   = 1
        memory = { 1.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }
    withName: 'TSS_ENRICHMENT' {
        cpus   = 4
        memory = { 2.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withName: 'QC_TSS_TABLE' {
        cpus   = 1
        memory = { 1.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }
    withName: 'FRIP' {
        cpus   = 1
        memory = { 1.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withName: 'QC_FRIP_TABLE' {
        cpus   = 1
        memory = { 1.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }
    withName: 'QC_PEAK_STATS' {
        cpus   = 1
        memory = { 1.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }
    withName: 'MULTIQC' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withName: 'NORM_TMM' {
        cpus   = 4
        memory = { 4.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withName: 'BIGWIG' {
        cpus   = 8
        memory = { 4.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withName: 'MACS3' {
        cpus   = 4
        memory = { 6.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withName: 'PEAK_MERGE' {
        cpus   = 1
        memory = { 1.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    // ---- Pre-aligned BAMs and downstream steps (differential accessibility, annotation, motifs) ----------------------
    // ESTIMATES, not measured on a full run yet: replace them with the trace of the first full downstream run.
    // The cpus of DIFF_ACCESS and MOTIF_ENRICHMENT are the params diff_cpus and motif_cpus (the process directive alone is
    // overridden by the process {} default above, so they are set here too).
    withName: 'BAM_PREALIGNED' {
        cpus   = 2
        memory = { 2.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withName: 'TXDB_BUILD' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    // csaw counts the bins of every BAM of one comparison (16 GB x attempt); cpus = diff_cpus (BiocParallel MulticoreParam).
    withName: 'DIFF_ACCESS' {
        cpus   = { params.diff_cpus }
        memory = { 16.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withName: 'DIFF_ANNOTATE' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    // A 190k-peak target-vs-other run exceeded 13 GB in a test: 32 GB x attempt. cpus = motif_cpus (1 = the legacy serial run).
    withName: 'MOTIF_ENRICHMENT' {
        cpus   = { params.motif_cpus }
        memory = { 32.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withName: 'MOTIF_COMMON' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }
}
