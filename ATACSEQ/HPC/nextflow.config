/*
 * ATACSEQ — reproducible ATAC-seq pipeline (paired-end)
 * Reusable across projects/labmates: nothing project-specific lives here.
 * Each project supplies its own config.yaml (see examples/config.yaml,
 * fetched via `run_pipeline.sh init`) and runs with:
 *   nextflow run /project/rephilllab/ATACSEQ -profile pmacs -params-file config.yaml
 *
 * Directory convention (shared across all lab pipelines, not just this one):
 *   samplesheet.csv, peak_merges.csv — your own small input CSVs,
 *                                  live at the project root (config.yaml too)
 *   original_data/fastq/        — per-sample FASTQ(s): supplied directly by the user
 *                                  (this pipeline has no demultiplexing step);
 *                                  samplesheet.csv may also point at FASTQs elsewhere
 *   metadata/                   — pipeline-generated run metadata: Nextflow's own
 *                                  execution report/trace/timeline/DAG, LSF head-job logs,
 *                                  and .nextflow.log (NOT this pipeline's own inputs —
 *                                  kept for consistency with pipelines that do populate
 *                                  it with their own generated metadata)
 *   intermediate_files/         — large per-sample intermediates (trimmed FASTQ, aligned/filtered BAMs)
 *   results/<step>/             — final outputs, one subfolder per pipeline step
 *
 * Not relocatable into metadata/: .nextflow/ (Nextflow's own resume cache +
 * history) always lives at the directory nextflow was launched from — no
 * flag moves it independently, and moving the whole launch directory would
 * break every relative path in config.yaml. Verified empirically, not
 * assumed — see the pipeline's git history for the test.
 */

manifest {
    name            = 'ATACSEQ'
    description     = 'Reproducible ATAC-seq pipeline (trim -> align -> filter -> dedup -> QC -> TMM -> bigWig -> MACS3) for PMACS/LSF'
    author          = 'Rephill Lab'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=26.04.0'
    version         = '0.1.0'
}

// ---------------------------------------------------------------------------
// Default parameters — override per-project via -params-file config.yaml
// (do NOT edit these defaults for a specific project; use your own config.yaml)
// ---------------------------------------------------------------------------
params {
    // ---- Project identity ---------------------------------------------
    project_name         = 'my_atacseq'    // prefix of the QC report and other project-level outputs

    // ---- Inputs (CSVs live at the project root) -------------------------
    samplesheet          = 'samplesheet.csv'   // one row per library: sample_id,fastq_1,fastq_2,condition,replicate,tmm_group,tmm_group_legacy,peak_group,exclude,bam (bam: a final BAM instead of FASTQ)
    peak_merges          = null   // peak merges CSV: one row per merged BED: name,peak_groups (comma list, quoted); null = none
    // Optional: a directory of FASTQs. run_pipeline.sh moves its *.fastq.gz / *.fastq
    // into original_data/fastq/ (unless it already is that directory) and rewrites
    // this value. The samplesheet's fastq_1/fastq_2 paths are used as given either way.
    fastq_dir            = null

    // ---- Output / directory convention -------------------------------
    // See the directory-convention comment at the top of this file.
    outdir               = './results'
    metadata_dir         = './metadata'
    intermediate_dir     = './intermediate_files'
    publish_mode         = 'copy'   // 'copy' (safe default) or 'symlink' (saves space, same filesystem only)
    lsf_exclude_hosts    = ''       // pmacs profile: comma list of LSF hosts never used (e.g. 'nodeNNN' while that node is broken)
    // Launch timestamp (yyyyMMdd_HHmmss): names the trace, report, timeline and DAG files, so a resumed run
    // does not overwrite the previous run's files.
    run_timestamp        = new Date().format('yyyyMMdd_HHmmss')

    // ---- References ---------------------------------------------------
    genome_index         = null   // bowtie2 index PREFIX of the genome (required)
    chrom_sizes          = null   // chrom.sizes of the genome (recorded and validated if set; no process uses it)
    blacklist            = null   // blacklist BED (pair-aware removal); empty/null = skip BLACKLIST_FILTER
    gtf                  = null   // gene annotation GTF (recorded and validated if set)
    tss_bed              = null   // TSS BED for TSS enrichment (required when TSS enrichment runs)
    effective_genome_size = null  // MACS3 -g effective genome size (required when MACS3 runs)
    contamination_index  = null   // bowtie2 index PREFIX of contaminant genomes; empty/null = skip CONTAMINATION

    // ---- Step switches -------------------------------------------------
    run_fastqc           = true   // FastQC on raw and trimmed reads
    trim                 = true   // run trimmomatic before alignment
    run_tss_enrichment   = true   // TSS enrichment (needs tss_bed)
    run_macs3            = true   // MACS3 peak calling per peak group
    run_multiqc          = true   // MultiQC report
    tn5_shift            = false  // true = deepTools alignmentSieve --ATACshift before QC/TMM/bigWig/MACS3
    remove_duplicates    = true   // sambamba markdup -r (false = mark duplicates only)
    help                 = false

    // ---- Trimming -------------------------------------------------------
    trim_adapter_set     = 'NexteraPE-PE'           // trimmomatic adapter file (bin/ adapter set name)
    trim_illuminaclip    = '2:30:10:8:True'         // ILLUMINACLIP seed/palindrome parameters
    trim_steps           = 'LEADING:3 TRAILING:3 SLIDINGWINDOW:4:20'   // trimmomatic steps
    trim_minlen          = 25                       // trimmomatic MINLEN

    // ---- Alignment ------------------------------------------------------
    bowtie2_mode         = 'local'          // local | end_to_end
    bowtie2_minins       = 10               // bowtie2 -I (null = not passed)
    bowtie2_maxins       = 2000             // bowtie2 -X
    bowtie2_args         = ''               // extra bowtie2 arguments; empty
    align_chunk_pairs    = 10000000         // read pairs per ALIGN task (bowtie2 -s/-u chunks, merged by ALIGN_MERGE); 0 or null = align each library in one task
    alignment_min_pct    = 20               // alignment rate below which ALIGNMENT_SUMMARY warns (never fails)

    // ---- Filtering ------------------------------------------------------
    mapq                 = 30               // minimum MAPQ kept (mapq 0 reproduces legacy)
    remove_chroms        = 'chrM'           // comma list of contigs removed; empty/null = keep all contigs

    // ---- QC -------------------------------------------------------------
    tss_flank            = 2000             // TSS enrichment flank (bp each side of the TSS)

    // ---- TMM normalisation ---------------------------------------------
    tmm_bin_size         = 10000            // genomic bin size for TMM (bp)
    tmm_max_frag         = 'auto'           // max fragment size: auto (largest proper-pair fragment in the group) | positive integer
    tmm_group_column     = 'tmm_group'      // samplesheet column defining TMM groups (alternative: tmm_group_legacy)

    // ---- bigWig tracks --------------------------------------------------
    bigwig_bin_size      = 10               // bamCoverage --binSize
    bigwig_units         = 'none'           // none | cpm | rpkm
    bigwig_extend_reads  = true             // bamCoverage --extendReads: fragment coverage (legacy false = per-mate read coverage)
    bigwig_center_reads  = false            // bamCoverage --centerReads (legacy true; a no-op unless extend_reads is true)
    bigwig_args          = ''               // extra bamCoverage arguments

    // ---- Peaks: MACS3 ---------------------------------------------------
    macs3_qvalue         = 0.05             // MACS3 -q
    macs3_min_length     = 250              // MACS3 --min-length (null = off)
    macs3_max_gap        = 500              // MACS3 --max-gap (null = off)
    macs3_fe_cutoff      = 2.0              // MACS3 --fe-cutoff (a value <= 1 = off)
    macs3_call_summits   = false            // MACS3 --call-summits
    macs3_broad          = false            // MACS3 --broad
    macs3_broad_cutoff   = 0.1              // MACS3 --broad-cutoff
    macs3_args           = ''               // extra MACS3 arguments

    // ---- Downstream analyses: differential accessibility, peak annotation, motifs -----------------------
    // Off by default (the pipeline stops after the peaks, FRiP and QC, as before). See README "Downstream analyses".
    // Values are the AV_ATACSEQ_2026 defaults; the older AV / AM values are in the comments.
    run_differential     = false  // DIFF_ACCESS: csaw/edgeR differential tables, one task per comparison (needs comparisons)
    run_annotation       = false  // DIFF_ANNOTATE: ChIPseeker annotation of each comparison's peaks table (needs gtf)
    run_motifs           = false  // MOTIF_ENRICHMENT (per comparison and motif_regions set, and per motif_targets row) + MOTIF_COMMON
    comparisons          = null   // CSV: name,case,control,group_column,block_column,case_peaks,control_peaks,pooled,fixed_dispersion (required when a run_* is on)
    peak_files           = null   // CSV: name,path. Existing peak files usable as peak groups in case_peaks / control_peaks (null = none)
    diff_tables          = null   // CSV: name,regions,path. Existing differential tables (regions peaks | promoters); those are not computed (null = none)
    motif_targets        = null   // CSV: name,type,target,comparison,label,min_peaks. Target-vs-other motif analyses (type gene | regions; null = none)

    // ---- Species, genome build and annotation packages ---------------------------------------------
    species              = 'Homo sapiens'   // Homo sapiens | Mus musculus (AM: 'Mus musculus')
    genome_build         = 'hs1'            // build of the BAMs and of the GTF (AM: 'mm39')
    bsgenome             = null             // BSgenome package for the chromosome lengths; null = BSgenome.Hsapiens.UCSC.<genome_build> (Mmusculus for Mus musculus)
    org_db               = null             // annotation package (gene symbols); null = org.Hs.eg.db (org.Mm.eg.db for Mus musculus)

    // ---- Differential accessibility (DIFF_ACCESS) -------------------------------------------------------
    diff_regions         = 'peaks'          // peaks | peaks,promoters (AV example: 'peaks,promoters'; promoters need gtf)
    diff_minq            = 10               // csaw readParam minq (minimum mapping quality)
    diff_pe              = 'both'           // both | none (older AV/AM csaw_parameters.R: 'none', paired data counted as single-end)
    diff_max_frag        = 500              // csaw readParam max.frag (csaw default; the legacy never set it)
    diff_dedup           = null             // null = remove_duplicates true ? 'false' : 'true'; or true | false | auto (auto = legacy rule: TRUE when a comparison has <= 2 BAMs)
    diff_bin_size        = 10000            // csaw window width for the normalisation factors (bp)
    diff_lfc             = 0.585            // |logFC| threshold for the up/down BEDs and the printed counts (older: 1)
    diff_fdr             = 0.1              // FDR threshold for the printed counts only (no table is filtered by it)
    diff_table           = 'best'           // best (merged$best) | combined (merged$combined; older AM)
    diff_qlf_min_libs    = 3                // quasi-likelihood F-test when a comparison has >= this many libraries, else fixed dispersion + LRT
    diff_fixed_dispersion = 0.05            // LRT dispersion (legacy per-line 0.05; the legacy gd2 chunk used 0.15: set fixed_dispersion in comparisons.csv)
    diff_promoter_up     = 2000             // promoter window upstream of the TSS (bp)
    diff_promoter_down   = 200              // promoter window downstream of the TSS (bp)
    diff_promoter_min_fc = 4                // promoters kept when background abundance > log2(this) (filterWindowsGlobal)
    diff_cpus            = 4                // BiocParallel workers for the read counting (DIFF_ACCESS cpus)

    // ---- Peak annotation (DIFF_ANNOTATE) ----------------------------------------------------------------
    annotation_tss_region = '-2000,200'     // ChIPseeker tssRegion: upstream,downstream of the TSS (bp)
    annotation_fdr       = null             // null = annotate all regions (AV); older AV: 0.1 (keep FDR < 0.1, all regions when none pass)

    // ---- Motif enrichment (MOTIF_ENRICHMENT, MOTIF_COMMON) -----------------------------------------------
    motif_regions        = 'promoters'      // region sets per comparison: promoters | peaks | all_sites | promoter_sites | non-promoter_sites | distal_sites
                                            // (AM / older: 'promoter_sites,non-promoter_sites,all_sites' with motif_lfc 1)
    motif_lfc            = 0.585            // bins: logFC > lfc (increased) and logFC < -lfc (decreased) (older: 1)
    motif_min_score      = 10               // PWM hit threshold (min.score of calcBinnedMotifEnrR)
    motif_test           = 'binomial'       // test of calcBinnedMotifEnrR
    motif_max_kmer       = 3                // maxKmerSize: composition correction
    motif_background     = 'otherBins'      // background of calcBinnedMotifEnrR
    motif_seed           = 123              // RNGseed of the serial BiocParallel parameter (legacy)
    motif_top            = 40               // motifs shown in the heatmaps when more than this pass
    motif_padj_primary   = 2.0              // -log10 adjusted P for the primary selection (legacy padj < 0.01)
    motif_padj_relaxed   = 1.0              // -log10 adjusted P for the relaxed selection (legacy padj < 0.1)
    motif_min_bin_peaks  = 10               // diff mode: skip the analysis when a bin has fewer regions
    motif_target_min_peaks = 15             // target mode: default minimum regions in the target and in the other set (CSV min_peaks overrides)
    motif_pwm_rds        = null             // cached PWMList (legacy rds/pwms.rds); null = JASPAR2024 from the package
    motif_gene_column    = 'geneId'         // annotation column a gene target is searched in
    motif_match          = 'substring'      // gene target matching: substring (legacy grepl) | exact
    motif_cpus           = 1                // 1 = serial RNGseed run (the legacy result); >1 uses MulticoreParam (not bit-reproducible)
    motif_common_padj    = 0.10             // MOTIF_COMMON: a motif is significant in a comparison at this adjusted P
    motif_common_min_lines = 2              // MOTIF_COMMON: a motif is common when significant in at least this many comparisons
    motif_common_label_strip = null         // regex removed from the comparison names to make the labels (AV example: '_high_vs_low.*')

    // ---- Plots (every downstream plot) ----------------------------------------------------------------
    plot_font            = 'Helvetica'      // font family of the text in every plot (svg keeps it editable)
    plot_format          = 'svg'            // svg | pdf (pdf = the legacy file format)

    // ---- Replacing a step's script for one project ----------------------
    // Not declared here on purpose. Every step runs a script from bin/; a
    // project's config.yaml replaces one with a key named after the script
    // (file name without extension), e.g. `norm_tmm: utils/norm_tmm.R`,
    // plus optional `<name>_args: "..."` for extra arguments. See
    // stepScripts() in main.nf. Scripts are task inputs, so -resume re-runs
    // only the step whose script changed (and what's downstream of it).
}

// Base resources first: settings in the profiles below (e.g. test) must override them.
includeConfig 'conf/base.config'

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------
profiles {
    pmacs {
        includeConfig 'conf/pmacs.config'
    }
    local {
        process.executor    = 'local'
        apptainer.enabled    = false
        docker.enabled        = false
    }
    test {
        includeConfig 'conf/test.config'
    }
}


// ---------------------------------------------------------------------------
// Execution provenance — every run records its own report/trace/DAG.
// File names carry the launch timestamp (params.run_timestamp; a param, because a
// top-level `def` mixed with config blocks is rejected by the config parser), so a
// resumed run does not overwrite the previous run's trace.
// Pass -with-report/-with-trace/-with-timeline/-with-dag with your own path
// on the command line if you want a copy elsewhere.
// ---------------------------------------------------------------------------
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.metadata_dir}/pipeline_info/execution_timeline_${params.run_timestamp}.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.metadata_dir}/pipeline_info/execution_report_${params.run_timestamp}.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.metadata_dir}/pipeline_info/execution_trace_${params.run_timestamp}.txt"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.metadata_dir}/pipeline_info/pipeline_dag_${params.run_timestamp}.html"
}

// Completion message — defined here (not in main.nf) because config files
// use plain assignment for this hook, sidestepping main.nf's strict script
// parser (which rejects a top-level `workflow.onComplete {}` statement, and
// a version nested inside `workflow {}` resolves `workflow` to null).
workflow.onComplete = {
    // `log` is not bound in config-file closure scope (only in the pipeline
    // script) — use println here, not log.info.
    def status = workflow.success ? 'completed successfully' : 'FAILED'
    println "\nPipeline ${status}. Results in: ${params.outdir}\n"
    // Nextflow's own closing tally ("[FAILED] completed=N failed=M") counts every failed attempt, including
    // attempts that succeeded on retry; say so when the run itself succeeded.
    def failed = workflow.stats?.failedCount ?: 0
    if (workflow.success && failed > 0)
        println "${failed} task attempt(s) failed and succeeded on retry (see metadata/pipeline_info/execution_trace_${params.run_timestamp}.txt);\n" +
                "the [FAILED] tally printed below counts these attempts.\n"
}
